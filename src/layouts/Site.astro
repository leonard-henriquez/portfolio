---
/**
 * The site's document, for every page: the home page (src/pages/index.astro) and each project's page
 * (src/pages/projects/[slug]/index.astro). Every theme renders into it (see src/components/ThemeRoots.astro and
 * src/themes/types.ts):
 * - <head>: the page's metadata (the home page's, from `profile.seo`, unless the page passes its own), the social
 *   image of the default theme, every theme's CSS (bundled by Astro), and a blocking inline script that resolves the
 *   active theme before first paint (`?theme=` → stored choice → default) and applies its `meta.ts` settings,
 *   including the preload of its hero image (resolved here to the exact URLs the theme renders).
 * - <body>: a visually hidden pointer to the Markdown version (HTML-to-text tools used by AI agents drop the
 *   <head>, so its `rel="alternate"` link alone goes unseen), the theme roots (slot), the theme switcher, then an
 *   inline script that mounts the active theme when it isn't the default, and the loader of the active theme's `client.ts`.
 */
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import ThemeSwitcher from "../components/ThemeSwitcher.astro";
import { MARKDOWN_PATHS } from "../lib/markdown";
import { getPortfolio } from "../lib/portfolio";
import { profilePageJsonLd } from "../lib/structured-data";
import { documentSettings, headScript, mountScript, rootCss } from "../themes/document";
import { defaultTheme, themes } from "../themes/registry";
import type { ThemeHeroImage, ThemePreload } from "../themes/types";

/** Everything is optional: without props, the page is the home page. */
interface Props {
  title?: string;
  description?: string;
  ogType?: "website" | "article";
  /** Social image source. Defaults to the default theme's `ogImage`, then the profile hero image. */
  ogImage?: ImageMetadata;
  /** schema.org data, serialized (src/lib/structured-data.ts). Defaults to the home page's. */
  jsonLd?: string;
  /** The same page as Markdown, relative to the site root (src/lib/markdown.ts). Defaults to the whole site. */
  markdownPath?: string;
  /** Each theme's hero image on this page, by slug, to preload. Defaults to the themes' `meta.heroImage`. */
  heroImages?: Record<string, ThemeHeroImage | undefined>;
}

const portfolio = await getPortfolio();
const { profile } = portfolio;
const {
  title = profile.seo.title,
  description = profile.seo.description,
  ogType = "website",
  ogImage,
  jsonLd = profilePageJsonLd(portfolio, Astro.site!),
  markdownPath = MARKDOWN_PATHS.full,
  heroImages = Object.fromEntries(themes.map((t) => [t.slug, t.meta.heroImage?.(portfolio)])),
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogSource = ogImage ?? defaultTheme.meta.ogImage?.(portfolio) ?? profile.heroImage.src;
const og = await getImage({ src: ogSource, width: Math.min(1200, ogSource.width), format: "jpg" });
const ogUrl = new URL(og.src, Astro.site);
// Static values are the default theme's: what visitors without JavaScript get.
const initial = documentSettings(defaultTheme.meta);
const markdownUrl = new URL(markdownPath, Astro.site);
const llmsTxtUrl = new URL(MARKDOWN_PATHS.index, Astro.site);

const MIME: Record<string, string> = { jpg: "image/jpeg", jpeg: "image/jpeg", svg: "image/svg+xml" };

/**
 * A theme's hero image as a high-priority preload: `getImage` with the theme's own options returns the same
 * URLs and srcset as the `<Picture>`/`<Image>` it renders, for the format the browser picks first
 * (a `<Picture>`'s first source; an `<Image>`'s WebP). Browsers that can't decode that type skip the preload.
 */
async function heroPreload({ src, widths, sizes, formats, quality }: ThemeHeroImage): Promise<ThemePreload> {
  const format = formats?.[0] ?? "webp";
  const image = await getImage({ src, widths, sizes, format, quality });
  return {
    href: image.src,
    as: "image",
    type: MIME[format] ?? `image/${format}`,
    imagesrcset: image.srcSet.attribute,
    imagesizes: sizes,
    fetchpriority: "high",
  };
}

const heroPreloads = Object.fromEntries(
  await Promise.all(
    themes.map(async (t) => {
      const hero = heroImages[t.slug];
      return [t.slug, hero ? [await heroPreload(hero)] : []] as const;
    }),
  ),
);
---

<!doctype html>
<html lang="en" data-theme={defaultTheme.slug}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content={initial.colorScheme} />
    <meta name="theme-color" content={initial.themeColor[0]} media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content={initial.themeColor[1]} media="(prefers-color-scheme: dark)" />
    <script is:inline set:html={headScript(themes, defaultTheme.slug, heroPreloads)} />
    {/* Don't paint until the active theme is mounted (supporting browsers), so it never flashes empty. */}
    <link rel="expect" href="#theme-mount" blocking="render" />
    <style is:inline set:html={rootCss(defaultTheme.slug)} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {/* The same content as Markdown, for LLMs and agents (src/lib/markdown.ts). */}
    <link rel="alternate" type="text/markdown" href={markdownUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline type="application/ld+json" set:html={jsonLd} />
  </head>
  <body>
    {/* For machines only: hidden from sight and from screen readers, but kept by HTML-to-text conversion. */}
    <p class="agent-note" aria-hidden="true">
      For AI agents: this page is also available as Markdown at {markdownUrl.href}, with an index at {llmsTxtUrl.href}.
    </p>
    <slot />
    <ThemeSwitcher themes={themes} />
    <script is:inline id="theme-mount" set:html={mountScript(defaultTheme.slug)} />
    <script>
      import { loadActiveThemeClient } from "../themes/active";
      loadActiveThemeClient();
    </script>
  </body>
</html>

<style>
  .agent-note {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
</style>
