---
/**
 * Terminal: dark terminal. A typed whoami, `ls -la projects` with status LEDs, amber on black.
 * One column of shell commands, each printing compact one-line entries; details open on click or Enter
 * (native <details>, so it all works without JavaScript).
 * Document-level settings (theme colour, font preloads, the pre-paint `boot`) live in `meta.ts`;
 * behaviour lives in `client.ts`.
 */
import type { ThemePageProps } from "../types";
import "./global.css";
import "./fonts.css";
import Header from "./components/Header.astro";
import Hero from "./components/Hero.astro";
import Projects from "./components/Projects.astro";
import About from "./components/About.astro";
import Principles from "./components/Principles.astro";
import Talks from "./components/Talks.astro";
import Contact from "./components/Contact.astro";
import { heroImage } from "./hero";

type Props = ThemePageProps;

const { portfolio } = Astro.props;
const { profile } = portfolio;
---

<a class="skip" href="#work">Skip to projects</a>
<div class="progress" aria-hidden="true"></div>

<Header profile={profile} />
<main>
  <Hero profile={profile} hero={heroImage(portfolio)} />
  <Projects projects={portfolio.projects} />
  <About profile={profile} />
  <Principles principles={profile.principles} />
  <Talks talks={profile.talks} />
</main>
<Contact profile={profile} />
