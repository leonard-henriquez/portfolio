---
import type { Profile } from "../../../lib/portfolio";
import { token } from "../lib";
import Prompt from "./Prompt.astro";

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;
const { contact } = profile;
const year = new Date().getFullYear();
---

<footer id="contact" class="tm-section contact">
  <Prompt cmd={`mail -s "hello"`} label="Contact" id="contact-title" class="reveal" />
  <div class="mail reveal">
    <a class="email" href={contact.mailto}>
      <span class="email-text">{contact.email}</span>
    </a>
    <button class="copy" type="button" data-copy={contact.email} data-switcher-avoid hidden>
      <span data-copy-label>copy</span>
    </button>
    <span class="sr-only" aria-live="polite" data-copy-status></span>
  </div>
  <div class="bar" data-switcher-avoid>
    <ul>
      {
        contact.links.map((link) => (
          <li>
            <a href={link.href} rel="me noopener">
              {link.label.toLowerCase()}
            </a>
          </li>
        ))
      }
    </ul>
    <p>exit 0 — {token(profile.location.city)}, {year}</p>
  </div>
</footer>

<style>
  .contact {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding-top: clamp(112px, 13vw, 180px);
    padding-bottom: 40px;
  }

  .mail {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 16px 28px;
  }

  .email {
    position: relative;
    max-width: 100%;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(34px, 7vw, 108px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: color 0.3s;
  }

  .email::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.02em;
    height: 2px;
    background: var(--amber);
    transform: scaleX(0);
    transform-origin: 100% 50%;
    transition: transform 0.6s var(--ease-out);
  }

  .email:hover,
  .email:focus-visible {
    color: var(--amber);
  }

  .email:hover::after,
  .email:focus-visible::after {
    transform: scaleX(1);
    transform-origin: 0 50%;
  }

  .copy {
    flex: none;
    padding: 6px 12px;
    border: 1px solid var(--line-2);
    border-radius: 3px;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 13px;
    cursor: pointer;
    transition:
      color 0.2s,
      border-color 0.2s,
      background-color 0.2s;
  }

  .copy:hover {
    border-color: var(--amber);
    color: var(--amber);
  }

  .copy.is-done {
    border-color: var(--green);
    color: var(--green);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
    padding-top: 20px;
    border-top: 1px solid var(--line);
    font-size: 13px;
  }

  .bar ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .bar a {
    text-decoration: none;
    transition: color 0.2s;
  }

  .bar a:hover {
    color: var(--amber);
  }

  .bar p {
    margin: 0;
    color: var(--dim);
  }
</style>
