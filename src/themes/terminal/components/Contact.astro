---
import { MARKDOWN_PATHS } from "../../../lib/markdown";
import type { Profile } from "../../../lib/portfolio";
import { token } from "../lib";
import Prompt from "./Prompt.astro";

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;
const { contact } = profile;
const { preferred } = contact;
// "linkedin.com/in/…": the URL as you would type it after `open`.
const host = preferred.href.replace(/^https?:\/\/(www\.)?/, "").replace(/\/$/, "");
const year = new Date().getFullYear();
// For AI agents: the Markdown version of the site (src/lib/markdown.ts).
const llmsTxt = new URL(MARKDOWN_PATHS.index, Astro.site);
---

<footer id="contact" class="tm-section contact">
  <Prompt cmd={`open ${host}`} label="Contact" id="contact-title" />
  <div class="reach reveal">
    {contact.intro && <p class="pitch">{contact.intro}</p>}
    <a class="cta" href={preferred.href} rel="me noopener">
      <span class="cta-caret" aria-hidden="true">→</span> message me on {preferred.label.toLowerCase()}
    </a>
  </div>
  <div class="bar" data-switcher-avoid>
    <ul>
      {
        contact.links.map((link) => (
          <li>
            <a href={link.href} rel="me noopener">
              {link.label.toLowerCase()}
            </a>
          </li>
        ))
      }
      <li class="agents">
        <a href={llmsTxt} type="text/plain" title="This site as Markdown, for AI agents">llms.txt</a>
      </li>
    </ul>
    <p>exit 0 — {token(profile.location.city)}, {year}</p>
  </div>
</footer>

<style>
  /* Same frame as every section (.tm-section); the footer bar sits a rhythm step below. */
  .contact {
    padding-bottom: 40px;
  }

  .reach {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--gap);
  }

  /* The lead style (see Page.astro). */
  .pitch {
    max-width: 34ch;
    margin: 0;
    font-family: var(--serif);
    font-style: italic;
    font-size: var(--fs-lead);
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .cta {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    padding: 10px 16px;
    border: 1px solid var(--line-2);
    border-radius: 3px;
    font-size: var(--fs-text);
    text-decoration: none;
    transition:
      color 0.2s,
      border-color 0.2s;
  }

  .cta-caret {
    color: var(--amber);
    transition: transform 0.3s var(--ease-out);
  }

  .cta:hover,
  .cta:focus-visible {
    border-color: var(--amber);
    color: var(--amber);
  }

  .cta:hover .cta-caret,
  .cta:focus-visible .cta-caret {
    transform: translateX(3px);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px;
    margin-top: calc(var(--rhythm) / 2);
    padding-top: 20px;
    border-top: 1px solid var(--line);
    font-size: var(--fs-meta);
  }

  .bar ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .bar a {
    text-decoration: none;
    transition: color 0.2s;
  }

  .bar a:hover {
    color: var(--amber);
  }

  .bar p {
    margin: 0;
    color: var(--dim);
  }

  /* Phones: no room for a third link next to the status line. The link stays in the markup for agents. */
  @media (max-width: 479px) {
    .agents {
      display: none;
    }
  }
</style>
