---
import { Image } from "astro:assets";
import type { Project } from "../../../lib/portfolio";

interface Props {
  project: Project;
}

const { project: p } = Astro.props;
const img = p.image.photo;
const meta = [
  { key: "role", value: p.role },
  { key: "period", value: p.period },
  { key: "status", value: p.statusLabel },
  ...(p.stack.length ? [{ key: "stack", value: p.stack.join(" · ") }] : []),
  ...(p.tags.length ? [{ key: "tags", value: p.tags.map((t) => `#${t}`).join(" ") }] : []),
];
// Staggered "printing" of the README when the row opens.
let i = 0;
const next = () => `--i:${i++}`;
---

<li class="row reveal" id={p.anchor} data-row={p.id}>
  <details>
    <summary>
      <span class="cols">
        <span class="perm" aria-hidden="true">drwxr-xr-x</span>
        <span class="status">
          <span class="led" data-status={p.status} aria-hidden="true"></span>
          <span>{p.status}</span>
        </span>
        <span class="main">
          <span class="name">{p.folder}</span>
          <span class="sum">{p.summary}</span>
        </span>
        <span class="year">{p.period}</span>
        <span class="tog" aria-hidden="true"></span>
      </span>
    </summary>

    <div class="readme">
      <p class="cmd" aria-hidden="true" style={next()}><span class="ps1">~ $</span> cat {p.folder}README.md</p>
      <div class="grid">
        <div class="doc">
          <h3 style={next()}><span class="hash" aria-hidden="true"># </span>{p.title}</h3>
          {p.dek !== p.summary && <p class="dek" style={next()}>{p.dek}</p>}
          {p.hasBody && <div class="body" style={next()} set:html={p.html} />}
          {
            p.links.length > 0 && (
              <ul class="links" style={next()}>
                {p.links.map((link) => (
                  <li>
                    <a href={link.href} rel="noopener">
                      {link.label}
                      <span aria-hidden="true"> ↗</span>
                    </a>
                  </li>
                ))}
              </ul>
            )
          }
        </div>
        <div class="side">
          <figure style={next()}>
            <Image
              src={img.src}
              alt={img.alt}
              widths={[360, 720]}
              sizes="(min-width: 600px) 340px, calc(100vw - 40px)"
              format={img.pixelated ? "png" : undefined}
              loading="lazy"
              decoding="async"
              class:list={["shot", { pixelated: img.pixelated }]}
              style={`object-position:${img.position}`}
            />
            <figcaption><span aria-hidden="true"># </span>{img.caption}</figcaption>
          </figure>
          <dl class="meta" style={next()}>
            {
              meta.map((m) => (
                <div>
                  <dt>{m.key}</dt>
                  <dd>{m.value}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
      {
        p.highlights.length > 0 && (
          <div class="hl" style={next()}>
            <h4>
              <span aria-hidden="true">## </span>highlights
            </h4>
            <ol>
              {p.highlights.map((h, n) => (
                <li style={next()}>
                  <p class="hl-title">
                    <span class="hl-no" aria-hidden="true">
                      {String(n + 1).padStart(2, "0")}
                    </span>
                    {h.title}
                  </p>
                  <p class="hl-body">{h.body}</p>
                  {h.result && <p class="hl-result">{h.result}</p>}
                  {h.stack.length > 0 && <p class="hl-stack">{h.stack.join(" · ")}</p>}
                </li>
              ))}
            </ol>
          </div>
        )
      }
    </div>
  </details>
</li>

<style>
  .row {
    border-bottom: 1px solid var(--line);
  }

  summary {
    position: relative;
    display: block;
    padding: 24px 12px;
    cursor: pointer;
    list-style: none;
    isolation: isolate;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:focus-visible {
    outline-offset: -2px;
  }

  /* Selection-style highlight that sweeps in from the left. */
  summary::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--bg-hover);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 0.5s var(--ease-out);
  }

  summary::after {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--amber);
    transform: scaleY(0);
    transition: transform 0.35s var(--ease);
  }

  summary:hover::before,
  summary:focus-visible::before,
  details[open] > summary::before {
    transform: none;
  }

  summary:hover::after,
  summary:focus-visible::after,
  details[open] > summary::after {
    transform: none;
  }

  .cols {
    display: grid;
    grid-template-columns: 10ch 11ch minmax(0, 1fr) 12ch 1.5ch;
    gap: 8px 32px;
    align-items: baseline;
  }

  .perm {
    color: var(--dim);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--muted);
  }

  .led {
    --c: var(--blue);
    position: relative;
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--c);
    box-shadow: 0 0 10px var(--c);
    align-self: center;
  }

  .led::after {
    content: "";
    position: absolute;
    inset: -5px;
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--c), transparent);
    opacity: 0.35;
    transition:
      opacity 0.3s,
      transform 0.3s var(--ease);
  }

  .led[data-status="shipped"] {
    --c: var(--green);
  }

  .led[data-status="building"] {
    --c: var(--amber);
  }

  .led[data-status="study"] {
    --c: var(--violet);
  }

  summary:hover .led::after,
  details[open] .led::after {
    opacity: 0.8;
    transform: scale(1.4);
  }

  .main {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .name {
    font-size: clamp(20px, 2vw, 26px);
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.01em;
    overflow-wrap: anywhere;
    transition:
      color 0.25s,
      transform 0.5s var(--ease-out);
  }

  summary:hover .name,
  summary:focus-visible .name,
  details[open] .name {
    color: var(--amber);
  }

  .sum {
    max-width: 70ch;
    color: var(--muted);
  }

  .year {
    color: var(--muted);
    text-align: right;
    white-space: nowrap;
  }

  /* Plus that turns into a cross when open. */
  .tog {
    position: relative;
    width: 12px;
    height: 12px;
    align-self: start;
    justify-self: end;
    margin-top: 0.45em;
    color: var(--dim);
    transition:
      transform 0.45s var(--ease-out),
      color 0.2s;
  }

  .tog::before,
  .tog::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1.5px;
    margin-top: -0.75px;
    background: currentColor;
  }

  .tog::after {
    transform: rotate(90deg);
  }

  summary:hover .tog {
    color: var(--amber);
  }

  details[open] .tog {
    color: var(--amber);
    transform: rotate(135deg);
  }

  /* README panel, aligned with the name column. */
  .readme {
    --indent: calc(21ch + 64px + 12px);
    padding: 8px 12px 48px var(--indent);
  }

  .cmd {
    margin: 0 0 20px;
    color: var(--muted);
  }

  .ps1 {
    color: var(--amber);
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(240px, 340px);
    gap: 32px 48px;
    align-items: start;
  }

  h3 {
    margin: 0 0 12px;
    font-size: 15px;
    font-weight: 600;
    color: var(--fg);
  }

  .hash,
  h4 span {
    color: var(--amber);
  }

  .dek {
    margin: 0 0 20px;
    max-width: 30ch;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(24px, 2.4vw, 32px);
    line-height: 1.15;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .body {
    max-width: 68ch;
    color: #c9c6be;
    font-size: 14px;
    line-height: 1.75;
  }

  .body :global(p) {
    margin: 0 0 14px;
  }

  .body :global(a) {
    color: var(--amber);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }

  .links a {
    color: var(--amber);
    text-decoration: underline;
    text-decoration-color: rgb(240 179 90 / 0.4);
    text-underline-offset: 4px;
    transition: text-decoration-color 0.2s;
  }

  .links a:hover {
    text-decoration-color: currentColor;
  }

  figure {
    margin: 0;
  }

  .shot {
    width: 100%;
    aspect-ratio: 18 / 11;
    height: auto;
    object-fit: cover;
    border: 1px solid var(--line-2);
    background: var(--bg-2);
  }

  .pixelated {
    image-rendering: pixelated;
  }

  figcaption {
    margin-top: 8px;
    color: var(--dim);
    font-size: 12px;
  }

  .meta {
    margin: 20px 0 0;
    font-size: 13px;
  }

  .meta div {
    display: grid;
    grid-template-columns: 8ch minmax(0, 1fr);
    gap: 16px;
    padding: 6px 0;
    border-top: 1px dashed var(--line-2);
  }

  .meta dt {
    color: var(--dim);
  }

  .meta dd {
    margin: 0;
    color: var(--fg);
    overflow-wrap: anywhere;
  }

  .hl {
    margin-top: 40px;
  }

  h4 {
    margin: 0 0 16px;
    font-size: 15px;
    font-weight: 600;
  }

  .hl ol {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    border: 1px solid var(--line);
    background: var(--line);
  }

  .hl li {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px;
    background: var(--bg);
  }

  .hl p {
    margin: 0;
  }

  .hl-title {
    font-weight: 600;
  }

  .hl-no {
    margin-right: 10px;
    color: var(--amber);
    font-weight: 400;
  }

  .hl-body {
    color: var(--muted);
    font-size: 13.5px;
    line-height: 1.65;
  }

  .hl-result {
    color: var(--amber);
    font-size: 13px;
  }

  .hl-stack {
    margin-top: auto !important;
    color: var(--dim);
    font-size: 12px;
  }

  @keyframes tm-readme-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    details[open] .readme [style*="--i"] {
      animation: tm-readme-in 0.55s calc(var(--i) * 45ms) var(--ease-out) both;
    }
  }

  @media (max-width: 1100px) {
    .cols {
      grid-template-columns: 10ch 11ch minmax(0, 1fr) auto 1.5ch;
      gap: 8px 24px;
    }

    .readme {
      --indent: calc(21ch + 48px + 12px);
    }

    .grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .side {
      display: grid;
      grid-template-columns: minmax(0, 340px) minmax(0, 1fr);
      gap: 24px;
      align-items: start;
    }

    .meta {
      margin: 0;
    }
  }

  /* Mobile: perms + status + year on one line, then the name, then the summary. */
  @media (max-width: 820px) {
    summary {
      padding: 20px 4px;
    }

    .cols {
      grid-template-columns: auto auto minmax(0, 1fr) auto;
      grid-template-areas:
        "perm status year tog"
        "main main main main";
      gap: 10px 16px;
      font-size: 13px;
    }

    .perm {
      grid-area: perm;
    }

    .status {
      grid-area: status;
    }

    .year {
      grid-area: year;
    }

    .tog {
      grid-area: tog;
    }

    .main {
      grid-area: main;
      font-size: 14px;
    }

    .name {
      font-size: 21px;
    }

    .readme {
      padding: 4px 4px 40px;
      font-size: 14px;
    }

  }

  @media (max-width: 600px) {
    .side {
      grid-template-columns: minmax(0, 1fr);
    }

    .meta {
      margin-top: 4px;
    }
  }

  @media (max-width: 380px) {
    .perm {
      display: none;
    }

    .cols {
      grid-template-areas:
        "status status year tog"
        "main main main main";
    }
  }
</style>
