---
import { Image } from "astro:assets";
import type { Project } from "../../../lib/portfolio";

interface Props {
  project: Project;
}

/*
 * One `ls -la` line: permissions, status, period, folder, teaser. Opening it swaps the teaser (`focus`) for the
 * full `summary` in place and prints the README below: dek, body, links, picture, facts, highlights.
 */
const { project: p } = Astro.props;
const img = p.image.photo;
// Status and period are on the line itself.
const facts = [
  { key: "role", value: p.role },
  ...(p.stack.length ? [{ key: "stack", value: p.stack.join(" · ") }] : []),
  ...(p.tags.length ? [{ key: "tags", value: p.tags.map((t) => `#${t}`).join(" ") }] : []),
];
const teaser = p.focus !== p.summary;
---

<li class="tm-row ln" id={p.anchor} data-row={p.id}>
  <!-- Same name on every project: opening one closes the others. -->
  <details name="projects">
    <summary class="tm-line">
      <span class="c-meta t-meta t-dim perm" aria-hidden="true">drwxr-xr-x</span>
      <span class="c-meta t-meta status">
        <span class="led" data-status={p.status} aria-hidden="true"></span>{p.status}
      </span>
      <span class="c-meta t-meta">{p.period}</span>
      <span class="c-main">
        <span class="c-name t-name">{p.folder}</span>
        {
          teaser ? (
            <>
              <span class="c-sec t-text c-clip c-closed">{p.focus}</span>
              <span class="c-sec t-text c-open">{p.summary}</span>
            </>
          ) : (
            <span class="c-sec t-text c-clip">{p.summary}</span>
          )
        }
      </span>
      <span class="tm-tog" aria-hidden="true"></span>
    </summary>

    <div class="tm-body readme">
      <div class="grid">
        <div class="doc">
          {p.dek !== p.summary && <p class="t-lead">{p.dek}</p>}
          {p.hasBody && <div class="prose t-text" set:html={p.html} />}
          {
            p.links.length > 0 && (
              <ul class="links t-text">
                {p.links.map((link) => (
                  <li>
                    <a class="tm-link" href={link.href} rel="noopener">
                      {link.label}
                      <span aria-hidden="true"> ↗</span>
                    </a>
                  </li>
                ))}
              </ul>
            )
          }
        </div>
        <div class="side">
          <figure>
            <Image
              src={img.src}
              alt={img.alt}
              widths={[360, 720]}
              sizes="(min-width: 600px) 340px, calc(100vw - 40px)"
              format={img.pixelated ? "png" : undefined}
              loading="lazy"
              decoding="async"
              class:list={["shot", { pixelated: img.pixelated }]}
              style={`object-position:${img.position}`}
            />
            <figcaption class="t-meta t-dim"><span aria-hidden="true"># </span>{img.caption}</figcaption>
          </figure>
          <dl class="tm-dl t-meta">
            {
              facts.map((f) => (
                <div>
                  <dt>{f.key}</dt>
                  <dd>{f.value}</dd>
                </div>
              ))
            }
          </dl>
        </div>
      </div>
      {
        p.highlights.length > 0 && (
          <div class="hl">
            <h4 class="t-name">
              <span class="t-amber" aria-hidden="true">## </span>highlights
            </h4>
            <ol class="tm-list tm-narrow hl-list">
              {p.highlights.map((h, n) => (
                <li class="tm-row">
                  <details>
                    <summary class="tm-line">
                      <span class="c-meta t-meta t-amber">{String(n + 1).padStart(2, "0")}</span>
                      <span class="c-main">
                        <span class="c-name t-name">{h.title}</span>
                      </span>
                      <span class="tm-tog" aria-hidden="true" />
                    </summary>
                    <div class="tm-body">
                      <p class="t-text">{h.body}</p>
                      {h.result && (
                        <ul class="tm-diff t-text">
                          <li>{h.result}</li>
                        </ul>
                      )}
                      {h.stack.length > 0 && <p class="t-meta">{h.stack.join(" · ")}</p>}
                    </div>
                  </details>
                </li>
              ))}
            </ol>
          </div>
        )
      }
    </div>
  </details>
</li>

<style>
  .status {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
  }

  .led {
    --c: var(--blue);
    position: relative;
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--c);
    box-shadow: 0 0 10px var(--c);
  }

  .led::after {
    content: "";
    position: absolute;
    inset: -5px;
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--c), transparent);
    opacity: 0.35;
    transition:
      opacity 0.3s,
      transform 0.3s var(--ease);
  }

  .led[data-status="released"] {
    --c: var(--green);
  }

  .led[data-status="building"] {
    --c: var(--amber);
  }

  .led[data-status="study"] {
    --c: var(--violet);
  }

  summary:hover .led::after,
  details[open] .led::after {
    opacity: 0.8;
    transform: scale(1.4);
  }

  /* The README is wider than plain text bodies: it has a picture beside it. */
  .readme {
    gap: 20px;
  }

  .readme > .grid,
  .readme > .hl {
    max-width: none;
  }

  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(220px, 320px);
    gap: 24px 48px;
    align-items: start;
  }

  .doc {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 72ch;
  }

  h4 {
    margin: 0;
  }

  .doc .t-lead {
    max-width: 34ch;
  }

  .prose {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .prose :global(p) {
    margin: 0;
  }

  .prose :global(a) {
    color: var(--amber);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    padding: 0;
    list-style: none;
  }

  .side {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  figure {
    margin: 0;
  }

  .shot {
    width: 100%;
    aspect-ratio: 18 / 11;
    height: auto;
    object-fit: cover;
    border: 1px solid var(--line-2);
    background: var(--bg-2);
  }

  .pixelated {
    image-rendering: pixelated;
  }

  figcaption {
    margin-top: 8px;
  }

  .hl {
    display: flex;
    max-width: calc(72ch + 320px + 48px);
    flex-direction: column;
    gap: 12px;
    margin-top: 8px;
  }

  /* Nested rows: number · title · toggle. */
  .hl-list {
    --cols: 2ch minmax(0, 1fr) 2ch;
    --indent: 5ch;
  }

  /* Below this, the README's text gets the full width; picture and facts sit side by side under it. */
  @media (max-width: 1180px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .side {
      display: grid;
      grid-template-columns: minmax(0, 300px) minmax(0, 1fr);
      gap: 24px;
      align-items: start;
    }
  }

  @media (max-width: 1100px) {
    .perm {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .side {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
