---
import type { Profile } from "../../../lib/portfolio";
import Prompt from "./Prompt.astro";

interface Props {
  principles: Profile["principles"];
}

const { principles } = Astro.props;
---

{
  principles.length > 0 && (
    <section id="principles" class="tm-section principles" aria-labelledby="principles-title">
      <Prompt cmd="cat principles.md" label="Principles" id="principles-title" class="reveal" />
      <ol class="grid reveal" data-print>
        {principles.map((p, i) => (
          <li class="ln" style={`--i:${i}`}>
            <p class="no" aria-hidden="true">
              {p.no2}
            </p>
            <h3>{p.title}</h3>
            <p class="body">{p.body}</p>
          </li>
        ))}
      </ol>
    </section>
  )
}

<style>
  /* Cells framed by the list's top/left edges and their own right/bottom ones, so a short last row leaves no block. */
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  li {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  @media (min-width: 900px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .no {
    margin: 0;
    color: var(--amber);
    font-size: 13px;
  }

  h3 {
    margin: 0;
    font-size: 17px;
    font-weight: 500;
    line-height: 1.4;
  }

  .body {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.7;
  }

  @media (max-width: 480px) {
    li {
      padding: 20px 16px;
    }
  }
</style>
