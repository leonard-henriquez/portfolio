---
import type { Profile } from "../../../lib/portfolio";
import Prompt from "./Prompt.astro";

interface Props {
  principles: Profile["principles"];
}

/* One line per principle: number and title; the body opens below the title. */
const { principles } = Astro.props;
---

{
  principles.length > 0 && (
    <section id="principles" class="tm-section" aria-labelledby="principles-title">
      <Prompt cmd="cat principles.md" label="Principles" id="principles-title" />
      <ol class="tm-list tm-narrow" data-list="principles" data-print>
        {principles.map((p, i) => (
          <li class="tm-row ln" style={`--i:${i}`}>
            <details>
              <summary class="tm-line">
                <span class="c-meta t-meta t-amber">{p.no2}</span>
                <span class="c-main">
                  <span class="c-name t-name">{p.title}</span>
                </span>
                <span class="tm-tog" aria-hidden="true" />
              </summary>
              <div class="tm-body">
                <p class="t-text">{p.body}</p>
              </div>
            </details>
          </li>
        ))}
      </ol>
    </section>
  )
}

<style>
  /* number · title · toggle. */
  .tm-list {
    --cols: 2ch minmax(0, 1fr) 2ch;
    --indent: 5ch;
  }
</style>
