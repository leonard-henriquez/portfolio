---
import { Image } from "astro:assets";
import type { Project, ProjectStatus } from "../../../lib/portfolio";
import { directorySummary } from "../lib";
import Prompt from "./Prompt.astro";
import ProjectRow from "./ProjectRow.astro";

interface Props {
  projects: Project[];
  statusCounts: Record<ProjectStatus, number>;
}

const { projects, statusCounts } = Astro.props;
---

<section id="work" class="tm-section work" aria-labelledby="work-title">
  <Prompt cmd="ls -la ~/projects" label="Projects" id="work-title" class="reveal" />
  <ul class="list" data-list>
    {projects.map((project) => <ProjectRow project={project} />)}
  </ul>
  <div class="foot">
    <p>{directorySummary(projects.length, statusCounts)}</p>
    <p class="keys" aria-hidden="true"><kbd>j</kbd> <kbd>k</kbd> move · <kbd>enter</kbd> open</p>
  </div>

  <!-- Cursor-following preview (fine pointers only); stays display:none, so its lazy images load on first hover. -->
  <div class="peek" data-peek aria-hidden="true" hidden>
    <div class="peek-inner" data-peek-inner>
      {
        projects.map((p) => {
          const img = p.image.photo;
          return (
            <Image
              src={img.src}
              alt=""
              widths={[300, 600]}
              sizes="300px"
              format={img.pixelated ? "png" : undefined}
              loading="lazy"
              decoding="async"
              data-peek-img={p.id}
              class:list={["peek-img", { pixelated: img.pixelated }]}
              style={`object-position:${img.position}`}
            />
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .list {
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: 20px;
    color: var(--dim);
    font-size: 13px;
  }

  .foot p {
    margin: 0;
  }

  kbd {
    display: inline-block;
    min-width: 1.6em;
    padding: 0 0.4em;
    border: 1px solid var(--line-2);
    border-radius: 3px;
    color: var(--muted);
    font: inherit;
    font-size: 12px;
    line-height: 1.5;
    text-align: center;
  }

  .keys {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .keys {
      display: block;
    }
  }

  .peek {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 30;
    width: 300px;
    aspect-ratio: 18 / 11;
    pointer-events: none;
    will-change: transform;
  }

  .peek-inner {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border: 1px solid var(--line-2);
    background: var(--bg-2);
    box-shadow: 0 30px 60px -20px rgb(0 0 0 / 0.8);
    opacity: 0;
    transform: scale(0.85);
    transition:
      opacity 0.3s var(--ease),
      transform 0.45s var(--ease-out);
  }

  .peek-inner.is-on {
    opacity: 1;
    transform: none;
  }

  .peek-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.12);
    transition:
      opacity 0.35s var(--ease),
      transform 0.8s var(--ease-out);
  }

  .peek-img.is-on {
    opacity: 1;
    transform: none;
  }

  .pixelated {
    image-rendering: pixelated;
  }
</style>
