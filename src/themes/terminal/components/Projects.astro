---
import { Image } from "astro:assets";
import type { Project } from "../../../lib/portfolio";
import Prompt from "./Prompt.astro";
import ProjectRow from "./ProjectRow.astro";

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
// The name column fits the longest folder name, so every row's teaser starts at the same column, like `ls`.
const nameWidth = Math.max(...projects.map((p) => p.folder.length));
---

<section id="work" class="tm-section work" aria-labelledby="work-title">
  <Prompt cmd="ls -la ~/projects" label="Projects" id="work-title" />
  <ul class="tm-list" data-list="projects" data-print style={`--name:${nameWidth}ch`}>
    {projects.map((project) => <ProjectRow project={project} />)}
  </ul>

  <!-- Cursor-following preview (fine pointers only); stays display:none, so its lazy images load on first hover. -->
  <div class="peek" data-peek aria-hidden="true" hidden>
    <div class="peek-inner" data-peek-inner>
      {
        projects.map((p) => {
          const img = p.image.photo;
          return (
            <Image
              src={img.src}
              alt=""
              widths={[300, 600]}
              sizes="300px"
              format={img.pixelated ? "png" : undefined}
              loading="lazy"
              decoding="async"
              data-peek-img={p.id}
              class:list={["peek-img", { pixelated: img.pixelated }]}
              style={`object-position:${img.position}`}
            />
          );
        })
      }
    </div>
  </div>
</section>

<style>
  /* permissions · status · period · name · teaser · toggle. The body starts under the name. */
  .tm-list {
    --cols: 10ch 10ch 12ch var(--name) minmax(0, 1fr) 2ch;
    --indent: calc(32ch + 9ch);
  }

  @media (max-width: 1100px) {
    .tm-list {
      --cols: 10ch 12ch var(--name) minmax(0, 1fr) 2ch;
      --indent: calc(22ch + 6ch);
    }
  }

  .peek {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 30;
    width: 300px;
    aspect-ratio: 18 / 11;
    pointer-events: none;
    will-change: transform;
  }

  .peek-inner {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border: 1px solid var(--line-2);
    background: var(--bg-2);
    box-shadow: 0 30px 60px -20px rgb(0 0 0 / 0.8);
    opacity: 0;
    transform: scale(0.85);
    transition:
      opacity 0.3s var(--ease),
      transform 0.45s var(--ease-out);
  }

  .peek-inner.is-on {
    opacity: 1;
    transform: none;
  }

  .peek-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.12);
    transition:
      opacity 0.35s var(--ease),
      transform 0.8s var(--ease-out);
  }

  .peek-img.is-on {
    opacity: 1;
    transform: none;
  }

  .pixelated {
    image-rendering: pixelated;
  }
</style>
