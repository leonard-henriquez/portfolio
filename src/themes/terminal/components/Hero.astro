---
import { Picture } from "astro:assets";
import type { Profile } from "../../../lib/portfolio";
import type { heroImage } from "../hero";
import Terminal from "./Terminal.astro";

interface Props {
  profile: Profile;
  /** From ../hero.ts, shared with meta.ts, which preloads exactly this image. */
  hero: ReturnType<typeof heroImage>;
}

const { profile, hero } = Astro.props;
// The night line suits this theme; the headline when the profile has none.
const tagline = profile.taglines.night ?? profile.headline;
const words = tagline.split(/\s+/);
---

<section id="top" class="hero" aria-label="Introduction">
  <div class="media">
    <Picture {...hero} loading="eager" fetchpriority="high" class="photo" />
  </div>
  <div class="shade" aria-hidden="true"></div>
  <div class="content tm-container">
    <Terminal profile={profile} />
    <h1>
      {
        words.map((word, i) => (
          <>
            <span class="word">
              <span style={`--i:${i}`}>{word}</span>
            </span>{" "}
          </>
        ))
      }
    </h1>
  </div>
  <a class="scroll" href="#work" aria-label="Scroll to projects">
    <span aria-hidden="true">scroll</span>
    <span class="rail" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    height: min(100svh, 980px);
    min-height: 640px;
    overflow: hidden;
    isolation: isolate;
  }

  .media {
    position: absolute;
    inset: 0;
    z-index: -2;
    animation: tm-media-in 2.4s var(--ease-out) both;
  }

  .media :global(.photo) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 70%;
    /* The render is very dark; lift it a touch so the ridges read behind the text. */
    filter: brightness(1.35) contrast(1.08) saturate(1.1);
    transform-origin: 50% 40%;
    will-change: transform;
  }

  .shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(120% 70% at 50% 0%, transparent 40%, rgb(11 12 14 / 0.45) 100%),
      linear-gradient(180deg, rgb(11 12 14 / 0.2) 0%, transparent 30%, transparent 55%, rgb(11 12 14 / 0.55) 82%, var(--bg) 100%);
  }

  /* Width and side padding from the shared .tm-container (see Page.astro). */
  .content {
    position: absolute;
    left: 0;
    right: 0;
    bottom: clamp(56px, 11vh, 128px);
    display: flex;
    flex-direction: column;
    gap: clamp(24px, 3.4vh, 36px);
  }

  h1 {
    margin: 0;
    max-width: 14ch;
    font-family: var(--serif);
    font-weight: 400;
    font-style: italic;
    font-size: clamp(50px, 7.6vw, 124px);
    line-height: 0.95;
    letter-spacing: -0.02em;
    text-wrap: balance;
    text-shadow: 0 2px 40px rgb(11 12 14 / 0.5);
  }

  /* Each word rises out of its own mask. Padding keeps italic overhangs and descenders unclipped. */
  .word {
    display: inline-block;
    overflow: clip;
    padding: 0.02em 0.08em 0.12em;
    margin: -0.02em -0.08em -0.12em;
    vertical-align: top;
  }

  .word > span {
    display: inline-block;
    animation: tm-word-in 1.1s calc(0.25s + var(--i) * 70ms) var(--ease-out) both;
  }

  .scroll {
    position: absolute;
    /* The container's right content edge. */
    right: max(var(--gutter), (100% - var(--max)) / 2);
    bottom: clamp(56px, 11vh, 128px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    color: var(--muted);
    font-size: var(--fs-meta);
    letter-spacing: 0.08em;
    text-decoration: none;
    writing-mode: vertical-rl;
    transition: color 0.2s;
  }

  .scroll:hover {
    color: var(--amber);
  }

  .rail {
    position: relative;
    width: 1px;
    height: 56px;
    overflow: hidden;
    background: var(--line-2);
  }

  .rail::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--amber);
    transform: translateY(-100%);
  }

  @keyframes tm-media-in {
    from {
      opacity: 0;
      transform: scale(1.06);
    }
  }

  @keyframes tm-word-in {
    from {
      transform: translateY(105%) rotate(2deg);
    }
  }

  @keyframes tm-rail {
    0% {
      transform: translateY(-100%);
    }
    60%,
    100% {
      transform: translateY(100%);
    }
  }

  @keyframes tm-hero-zoom {
    to {
      transform: scale(1.15) translateY(6%);
      opacity: 0.35;
    }
  }

  @keyframes tm-content-out {
    to {
      transform: translateY(-48px);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .rail::after {
      animation: tm-rail 2.4s 2s var(--ease) infinite;
    }

    @supports (animation-timeline: scroll()) {
      .media :global(.photo) {
        animation: tm-hero-zoom linear both;
        animation-timeline: scroll(root);
        animation-range: 0 100vh;
      }

      .content {
        animation: tm-content-out linear both;
        animation-timeline: scroll(root);
        animation-range: 10vh 90vh;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .media,
    .word > span {
      animation: none;
    }
  }

  @media (max-width: 720px) {
    .scroll {
      display: none;
    }
  }
</style>
