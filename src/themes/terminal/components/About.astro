---
import type { Profile } from "../../../lib/portfolio";
import Prompt from "./Prompt.astro";

interface Props {
  profile: Profile;
}

/*
 * `cat about.md`: the short version by default. "more" swaps it for the long one (the paragraphs retell the
 * short version, so the two are never shown together), the key figures and the quote.
 */
const { profile } = Astro.props;
const { about, numbers, quote } = profile;
const valueWidth = Math.max(0, ...numbers.map((n) => n.value.length));
---

<section id="about" class="tm-section about" aria-labelledby="about-title">
  <Prompt cmd="cat about.md" label="About" id="about-title" />
  <div class="body">
    <p class="t-lead short reveal">{about.short}</p>
    <details class="more">
      <summary class="t-meta">
        <span class="tm-tog" aria-hidden="true"></span>
        <span class="closed">more</span><span class="opened">less</span>
      </summary>
      <div class="long">
        {about.long.map((para) => <p class="t-text">{para}</p>)}
        {
          numbers.length > 0 && (
            <dl class="tm-list tm-narrow numbers" style={`--value:${valueWidth}ch`}>
              {numbers.map((n) => (
                <div class="tm-row tm-line">
                  <dt class="c-meta t-name t-amber">
                    <span class="sr-only">{n.value}</span>
                    <span aria-hidden="true" data-scramble>
                      {n.value}
                    </span>
                  </dt>
                  <dd class="c-sec t-text">{n.label}</dd>
                </div>
              ))}
            </dl>
          )
        }
        {
          quote && (
            <figure class="quote">
              <blockquote class="t-lead">{quote.text}</blockquote>
              {quote.context && <figcaption class="t-meta">— {quote.context.toLowerCase()}</figcaption>}
            </figure>
          )
        }
      </div>
    </details>
  </div>
</section>

<style>
  .body {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 72ch;
  }

  .short {
    max-width: 34ch;
    text-wrap: pretty;
  }

  /* Open: the long version replaces the short one. */
  .body:has(.more[open]) .short {
    display: none;
  }

  .more summary {
    display: inline-flex;
    align-items: center;
    gap: 1.5ch;
    padding: 4px 0;
    cursor: pointer;
    list-style: none;
    transition: color 0.2s;
  }

  .more summary::-webkit-details-marker {
    display: none;
  }

  .more summary:hover {
    color: var(--amber);
  }

  .more[open] .closed,
  .more:not([open]) .opened {
    display: none;
  }

  .long {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-top: 12px;
  }

  .long p {
    margin: 0;
  }

  .numbers {
    --cols: var(--value) minmax(0, 1fr);
    margin-top: 16px;
  }

  .numbers dt,
  .numbers dd {
    margin: 0;
    white-space: nowrap;
  }

  .numbers dd {
    white-space: normal;
  }

  .quote {
    margin: 24px 0 0;
  }

  blockquote {
    margin: 0;
  }

  figcaption {
    margin-top: 8px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .more[open] .long > * {
      animation: tm-body-in 0.5s var(--ease-out) both;
    }
  }
</style>
