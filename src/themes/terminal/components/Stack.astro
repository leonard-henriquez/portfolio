---
import type { Profile } from "../../../lib/portfolio";
import { tomlKey } from "../lib";
import Prompt from "./Prompt.astro";

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;

// stack.toml: one table for the stack groups, one for focus areas. Keys padded to align the "=".
const tables = [
  { name: "stack", rows: profile.stack.map((g) => ({ key: tomlKey(g.key), items: g.items })) },
  ...(profile.focusAreas.length ? [{ name: "focus", rows: [{ key: "areas", items: profile.focusAreas }] }] : []),
];
const width = Math.max(...tables.flatMap((t) => t.rows.map((r) => r.key.length)));
let i = 0;
---

<section id="stack" class="tm-section" aria-labelledby="stack-title">
  <Prompt cmd="cat stack.toml" label="Stack" id="stack-title" />
  <div class="file t-text" data-print>
    {
      tables.map((t, ti) => (
        <>
          {ti > 0 && <p class="ln blank" aria-hidden="true" />}
          <p class="ln table" style={`--i:${i++}`}>
            <span aria-hidden="true">[</span>
            {t.name}
            <span aria-hidden="true">]</span>
          </p>
          <dl>
            {t.rows.map((r) => (
              <div class="ln kv" style={`--i:${i++}`}>
                <dt>
                  <span class="key">{r.key}</span>
                  <span class="pad" aria-hidden="true">
                    {" ".repeat(width - r.key.length)} ={" "}
                  </span>
                </dt>
                <dd>
                  <span class="punct" aria-hidden="true">
                    [
                  </span>
                  {r.items.map((item, n) => (
                    <span class="item">
                      <span class="str">
                        <span aria-hidden="true">"</span>
                        {item}
                        <span aria-hidden="true">"</span>
                      </span>
                      <span class="punct" aria-hidden="true">
                        {n < r.items.length - 1 ? ", " : "]"}
                      </span>
                    </span>
                  ))}
                </dd>
              </div>
            ))}
          </dl>
        </>
      ))
    }
  </div>
</section>

<style>
  .ln {
    margin: 0;
  }

  .blank {
    height: 1.7em;
  }

  .table {
    color: var(--amber);
  }

  .file dl {
    margin: 0;
  }

  /* key = [ ... ] with a hanging indent so long arrays wrap under the first item. */
  .kv {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
  }

  .kv dd {
    margin: 0;
    padding-left: 1ch;
    text-indent: -1ch;
  }

  .key {
    color: var(--fg);
  }

  .pad,
  .punct {
    color: var(--dim);
  }

  .pad {
    white-space: pre;
  }

  .str {
    color: var(--string);
  }

  .item {
    text-indent: 0;
  }
</style>
