---
import type { Experience } from "../../../lib/portfolio";
import { displayHost, shortHash } from "../lib";
import Prompt from "./Prompt.astro";

interface Props {
  experience: Experience[];
}

/*
 * `git log --oneline --graph`, newest first: one commit per role, every one the same shape. The line is
 * hash · years · title @ organization; opening it prints the commit body: what was done, highlights as added
 * lines, then the same facts for every commit (org, about, date, type, skills).
 * The first role of each organization carries the organization's anchor (`#experience-<id>`).
 */
const { experience } = Astro.props;
const commits = experience.flatMap((org) => org.roles.map((role, n) => ({ org, role, anchor: n === 0 ? org.anchor : undefined })));
const titleWidth = Math.max(...commits.map((c) => c.role.title.length));
---

<section id="experience" class="tm-section" aria-labelledby="experience-title">
  <Prompt cmd="git log --oneline --graph" label="Experience" id="experience-title" />
  <ol class="tm-list log" data-list="experience" data-print style={`--name:${titleWidth}ch`}>
    {
      commits.map(({ org, role, anchor }, i) => (
        <li class="tm-row ln" style={`--i:${i}`} id={anchor}>
          <details>
            <summary class="tm-line">
              <span class="c-meta t-meta">
                <span class="t-dim" aria-hidden="true">
                  *{" "}
                </span>
                <span class="t-amber" aria-hidden="true">
                  {shortHash([org.id, role.title, role.start.iso].join("|"))}
                </span>
              </span>
              <span class="c-meta t-meta">{role.years}</span>
              <span class="c-main c-phrase">
                <span class="c-name t-name">{role.title}</span>{" "}
                <span class="c-sec t-text">@ {org.org}</span>
              </span>
              <span class="tm-tog" aria-hidden="true" />
            </summary>
            <div class="tm-body">
              {role.text && <p class="t-text">{role.text}</p>}
              {role.highlights.length > 0 && (
                <ul class="tm-diff t-text">
                  {role.highlights.map((h) => (
                    <li>{h}</li>
                  ))}
                </ul>
              )}
              <dl class="tm-dl t-meta">
                <div>
                  <dt>org</dt>
                  <dd>
                    {[org.org, ...org.details].join(" · ")}
                    {org.href && (
                      <>
                        {" · "}
                        <a class="tm-link" href={org.href} rel="noopener">
                          {displayHost(org.href)}
                          <span aria-hidden="true"> ↗</span>
                        </a>
                      </>
                    )}
                    {org.project && (
                      <>
                        {" · "}
                        <a class="tm-link" href={`#${org.project.anchor}`}>
                          projects/{org.project.id}
                          <span aria-hidden="true"> ↑</span>
                        </a>
                      </>
                    )}
                  </dd>
                </div>
                {org.summary && (
                  <div>
                    <dt>about</dt>
                    <dd>{org.summary}</dd>
                  </div>
                )}
                <div>
                  <dt>date</dt>
                  <dd>
                    {role.period}
                    {!role.current && ` (${role.duration})`}
                  </dd>
                </div>
                <div>
                  <dt>type</dt>
                  <dd>{role.typeLabel}</dd>
                </div>
                {role.skills.length > 0 && (
                  <div>
                    <dt>skills</dt>
                    <dd>{role.skills.join(", ")}</dd>
                  </div>
                )}
              </dl>
            </div>
          </details>
        </li>
      ))
    }
  </ol>
</section>

<style>
  /* graph + hash · years · title · @ org · toggle. The body starts under the title. */
  .log {
    --cols: 9ch 12ch var(--name) minmax(0, 1fr) 2ch;
    --indent: calc(21ch + 6ch);
  }

  /* The open commit's body hangs off the graph line, like `git log --graph`. */
  .log .tm-body {
    position: relative;
  }

  .log .tm-body::before {
    content: "";
    position: absolute;
    left: calc(8px + 0.5ch);
    top: 0;
    bottom: 12px;
    width: 1px;
    background: var(--line-2);
  }

  @media (max-width: 900px) {
    .log .tm-body {
      padding-left: 3ch;
    }

    .log .tm-body::before {
      left: calc(4px + 0.5ch);
    }

  }
</style>
