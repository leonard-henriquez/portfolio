---
import type { Profile } from "../../../lib/portfolio";
import { displayHost, shortHash } from "../lib";
import Prompt from "./Prompt.astro";

interface Props {
  profile: Profile;
}

/*
 * `git log --graph`: one commit per role, newest first. An organization with several roles is a merge commit on
 * the main line, its roles a side branch under it. `weight` sets how loud a commit is.
 */
const { profile } = Astro.props;
const { experience, education } = profile;
let line = 0;
const hash = (...parts: string[]) => shortHash(parts.join("|"));
---

<section id="experience" class="tm-section log" aria-labelledby="experience-title">
  <div class="history reveal">
    <Prompt cmd="git log --graph" label="Experience" id="experience-title" />
    <ol class="graph" data-print>
      {
        experience.map((org) => {
          const head = org.current;
          const summary = org.summary && <p class="msg">{org.summary}</p>;
          const trailers = (org.location || org.href || org.project) && (
            <p class="trailers">
              {org.location && <span>Location: {org.location}</span>}
              {org.project && (
                <a class="ext" href={`#${org.project.anchor}`}>
                  ls projects/{org.project.id}
                  <span aria-hidden="true"> ↑</span>
                </a>
              )}
              {org.href && (
                <a class="ext" href={org.href} rel="noopener">
                  {displayHost(org.href)}
                  <span aria-hidden="true"> ↗</span>
                </a>
              )}
            </p>
          );

          return org.multiRole ? (
            <li class:list={["ln", "commit", "merge", `w-${org.weight}`, { head }]} style={`--i:${line++}`} id={org.anchor}>
              <span class="node" aria-hidden="true" />
              <p class="line1">
                <span class="hash" aria-hidden="true">
                  {hash(org.id)}
                </span>
                {head && (
                  <span class="ref" aria-hidden="true">
                    (HEAD -&gt; now)
                  </span>
                )}
                <span class="merge-msg" aria-hidden="true">
                  Merge branch '{org.id}'
                </span>
              </p>
              <h3>{org.fullLabel}</h3>
              <p class="meta">
                {org.period}
                <span class="dim">
                  {" "}
                  · {org.roles.length} roles, {org.duration}
                </span>
              </p>
              {summary}
              {trailers}
              <ol class="branch">
                {org.roles.map((role) => (
                  <li class:list={["ln", "commit", { head: role.current }]} style={`--i:${line++}`}>
                    <span class="node" aria-hidden="true" />
                    <p class="line1">
                      <span class="hash" aria-hidden="true">
                        {hash(org.id, role.title, role.start.iso)}
                      </span>
                      <span class="period">{role.period}</span>
                    </p>
                    <h4>{role.title}</h4>
                    <p class="meta">
                      {role.typeLabel}
                      {!role.current && <span class="dim"> · {role.duration}</span>}
                    </p>
                    {role.text && <p class="msg">{role.text}</p>}
                    {role.highlights.length > 0 && (
                      <ul class="diff" role="list">
                        {role.highlights.map((h) => (
                          <li>{h}</li>
                        ))}
                      </ul>
                    )}
                    {role.skills.length > 0 && <p class="trailers">Skills: {role.skills.join(", ")}</p>}
                  </li>
                ))}
              </ol>
            </li>
          ) : (
            org.roles.map((role) => (
              <li class:list={["ln", "commit", `w-${org.weight}`, { head }]} style={`--i:${line++}`} id={org.anchor}>
                <span class="node" aria-hidden="true" />
                <p class="line1">
                  <span class="hash" aria-hidden="true">
                    {hash(org.id, role.title, role.start.iso)}
                  </span>
                  {head && (
                    <span class="ref" aria-hidden="true">
                      (HEAD -&gt; now)
                    </span>
                  )}
                  <span class="period">{role.period}</span>
                </p>
                <h3>
                  {role.title}, {org.fullLabel}
                </h3>
                <p class="meta">
                  {role.typeLabel}
                  {!role.current && <span class="dim"> · {role.duration}</span>}
                </p>
                {summary}
                {role.text && <p class="msg">{role.text}</p>}
                {role.highlights.length > 0 && (
                  <ul class="diff" role="list">
                    {role.highlights.map((h) => (
                      <li>{h}</li>
                    ))}
                  </ul>
                )}
                {role.skills.length > 0 && <p class="trailers">Skills: {role.skills.join(", ")}</p>}
                {trailers}
              </li>
            ))
          );
        })
      }
    </ol>
  </div>

  <div class="side">
    {
      education.length > 0 && (
        <div id="education" class="edu reveal">
          <Prompt cmd="tree ~/education" label="Education" id="education-title" />
          <div class="tree" data-print>
            <p class="ln root" style="--i:0" aria-hidden="true">
              ~/education
            </p>
            <ol class="dirs" role="list">
              {education.map((e, i) => (
                <li class:list={["ln", "dir", `w-${e.weight}`]} style={`--i:${i + 1}`} id={e.anchor}>
                  <p class="d-line">
                    <span class="d-name">
                      {/* Like `tree` and `ls`, a name with spaces is quoted. */}
                      {/\s/.test(e.school) && <span class="q" aria-hidden="true">'</span>}
                      {e.school}
                      {/\s/.test(e.school) && <span class="q" aria-hidden="true">'</span>}
                      <span class="q" aria-hidden="true">/</span>
                    </span>
                    <span class="y">{e.years}</span>
                  </p>
                  {e.program && <p class="d-prog">{e.program}</p>}
                  {e.note && <p class="d-note">{e.note}</p>}
                </li>
              ))}
            </ol>
            <p class="ln count" style={`--i:${education.length + 1}`} aria-hidden="true">
              {education.length} {education.length === 1 ? "directory" : "directories"}
            </p>
          </div>
        </div>
      )
    }

    {
      profile.talks.length > 0 && (
        <div class="talks reveal">
          <Prompt cmd="cat talks.txt" label="Talks and recognition" />
          <ul data-print>
            {profile.talks.map((t, i) => (
              <li class="ln" style={`--i:${i}`}>
                <span class:list={["y", { none: !t.year }]}>{t.year ?? <span aria-hidden="true">····</span>}</span>
                <span>{t.text}</span>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>

  {
    profile.quote && (
      <figure class="fortune reveal">
        <Prompt cmd="fortune" label="Quote" as="p" />
        <blockquote>
          <p>{profile.quote.text}</p>
        </blockquote>
        {profile.quote.context && <figcaption>— {profile.quote.context.toLowerCase()}</figcaption>}
      </figure>
    )
  }
</section>

<style>
  .log {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: 72px clamp(48px, 6vw, 96px);
    align-items: start;
  }

  .graph {
    position: relative;
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
  }

  .commit {
    position: relative;
    padding: 0 0 36px 32px;
  }

  /* The branch line between nodes. */
  .commit::before {
    content: "";
    position: absolute;
    left: 4px;
    top: 14px;
    bottom: -6px;
    width: 1px;
    background: var(--line-2);
  }

  .commit:last-child::before {
    display: none;
  }

  .node {
    position: absolute;
    left: 0;
    top: 7px;
    width: 9px;
    height: 9px;
    border: 1px solid var(--muted);
    border-radius: 50%;
    background: var(--bg);
  }

  .w-high > .node {
    border-color: var(--fg);
  }

  .w-low > .node {
    border-color: var(--dim);
  }

  .head > .node {
    border-color: var(--amber);
    background: var(--amber);
    box-shadow: 0 0 12px rgb(240 179 90 / 0.6);
  }

  /* A merge commit: a ring on the main line. */
  .merge:not(.head) > .node {
    background: var(--bg);
    box-shadow: inset 0 0 0 2px var(--bg), inset 0 0 0 9px currentColor;
    color: var(--line-2);
  }

  /*
   * The side branch, one lane to the right: it forks off the main line under the merge commit (top curve) and
   * joins it again after its oldest role (bottom curve). The main line runs on past it, on the merge commit.
   */
  .branch {
    position: relative;
    margin: 20px 0 12px;
    padding: 0;
    list-style: none;
  }

  .branch::before,
  .branch::after {
    content: "";
    position: absolute;
    left: -28px;
    width: 33px;
    height: 14px;
    border: 0 solid var(--line-2);
    border-right-width: 1px;
    pointer-events: none;
  }

  .branch::before {
    top: -12px;
    border-top-width: 1px;
    border-top-right-radius: 12px;
  }

  .branch::after {
    bottom: -14px;
    border-bottom-width: 1px;
    border-bottom-right-radius: 12px;
  }

  .branch .commit {
    padding-bottom: 28px;
  }

  .branch .commit:last-child {
    padding-bottom: 4px;
  }

  .branch .commit:last-child::before {
    display: block;
    bottom: 0;
  }

  .line1 {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    margin: 0;
    font-size: 13px;
  }

  .hash {
    color: var(--amber);
  }

  .ref {
    color: var(--green);
  }

  .period {
    color: var(--muted);
  }

  h3,
  h4 {
    margin: 6px 0 2px;
    font-size: 16px;
    font-weight: 500;
    line-height: 1.4;
  }

  /* Weight: louder titles for what matters most. */
  .w-high > h3 {
    font-size: 19px;
  }

  .w-low > h3 {
    color: var(--muted);
    font-size: 15px;
  }

  .merge-msg {
    color: var(--muted);
  }

  .meta {
    margin: 0 0 8px;
    color: var(--muted);
    font-size: 13px;
  }

  .dim {
    color: var(--dim);
  }

  .msg + .msg,
  .trailers + .msg {
    margin-top: 6px;
  }

  .trailers + .trailers {
    margin-top: 2px;
  }

  /* Highlights as added lines of a diff. */
  .diff {
    max-width: 62ch;
    margin: 8px 0 0;
    padding: 0;
    list-style: none;
    font-size: 14px;
    line-height: 1.7;
  }

  .diff li {
    position: relative;
    padding-left: 2ch;
    color: var(--green);
  }

  .diff li::before {
    content: "+";
    position: absolute;
    left: 0;
  }

  .trailers {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 20px;
    margin: 8px 0 0;
    color: var(--dim);
    font-size: 13px;
  }

  .trailers .ext {
    margin-top: 0;
  }

  .msg {
    max-width: 62ch;
    margin: 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.7;
  }

  .ext {
    display: inline-block;
    margin-top: 8px;
    color: var(--amber);
    font-size: 13px;
    text-decoration: underline;
    text-decoration-color: rgb(240 179 90 / 0.4);
    text-underline-offset: 4px;
  }

  .ext:hover {
    text-decoration-color: currentColor;
  }

  .side {
    display: flex;
    flex-direction: column;
    gap: 72px;
  }

  /* tree ~/education: rails and ticks drawn in CSS so they stay continuous when lines wrap. */
  .tree {
    margin-top: 32px;
    font-size: 14px;
    line-height: 1.6;
  }

  .tree p {
    margin: 0;
  }

  .root {
    color: var(--blue);
  }

  .dirs {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .dir {
    position: relative;
    padding: 10px 0 10px 4.5ch;
  }

  .dir::before,
  .dir::after {
    content: "";
    position: absolute;
    left: 0.5ch;
    background: var(--line-2);
  }

  /* The rail: through every entry, down to the tick of the last one. */
  .dir::before {
    top: 0;
    bottom: 0;
    width: 1px;
  }

  .dir:last-child::before {
    bottom: auto;
    height: calc(10px + 0.8em);
  }

  .dir::after {
    top: calc(10px + 0.8em);
    width: 3ch;
    height: 1px;
  }

  .d-line {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 16px;
  }

  .d-name {
    color: var(--blue);
  }

  .q {
    color: var(--dim);
  }

  .w-high .d-name {
    color: var(--fg);
    font-size: 16px;
    font-weight: 500;
  }

  .w-low .d-name {
    color: var(--muted);
  }

  .d-prog,
  .d-note {
    color: var(--muted);
    font-size: 13px;
  }

  .count {
    margin-top: 8px !important;
    color: var(--dim);
  }

  .talks ul {
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .talks li {
    display: grid;
    grid-template-columns: 5ch minmax(0, 1fr);
    gap: 20px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    font-size: 14px;
    line-height: 1.6;
  }

  .y {
    color: var(--amber);
  }

  .y.none {
    color: var(--dim);
  }

  .fortune {
    grid-column: 1 / -1;
    margin: 24px 0 0;
    padding-top: 48px;
    border-top: 1px solid var(--line);
  }

  blockquote {
    margin: 20px 0 0;
  }

  blockquote p {
    margin: 0;
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(36px, 5vw, 72px);
    line-height: 1;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  figcaption {
    margin-top: 16px;
    color: var(--muted);
    font-size: 13px;
  }

  @media (max-width: 900px) {
    .log {
      grid-template-columns: minmax(0, 1fr);
      gap: 64px;
    }

    .fortune {
      margin-top: 0;
    }
  }
</style>
