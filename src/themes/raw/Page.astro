---
/**
 * Raw: the original site. Tiny5 pixel type over iA Writer Mono, Friedrich's Wanderer as a dithered
 * pixel image, thick rules, and its own light/dark toggle (html[data-raw-scheme], see meta.ts and client.ts).
 * Every list is the same compact row (key · title · secondary line), with the rest of the item in a native
 * <details> under it: scannable by default, details on demand, readable without JavaScript.
 */
import { Image } from "astro:assets";
import { MARKDOWN_PATHS } from "../../lib/markdown";
import { pad } from "../../lib/portfolio";
import type { ThemePageProps } from "../types";
import "./global.css";
import { heroImage } from "./hero";

type Props = ThemePageProps;

const { profile, projects, span } = Astro.props.portfolio;
const { current, contact, sections } = profile;
const credit = profile.heroImage.credit;
// For AI agents: the Markdown version of the site (src/lib/markdown.ts).
const llmsTxt = new URL(MARKDOWN_PATHS.index, Astro.site);

// "Work" is the current company's work streams: the profile's current project, or the first with highlights.
const company = current.project ?? projects.find((p) => p.highlights.length > 0);
// Shared with meta.ts, which preloads exactly this image.
const hero = heroImage(Astro.props.portfolio);
const work = company?.highlights ?? [];

const projectCount = `${pad(projects.length, 2)} ${projects.length === 1 ? "project" : "projects"}, ${span.label}`;
const hasAbout = profile.about.long.length > 0 || profile.stack.length > 0 || profile.focusAreas.length > 0;

const nav = [
  ...(projects.length ? [{ label: "Projects", href: "#projects", hint: projectCount }] : []),
  ...(work.length ? [{ label: "Work", href: "#work", hint: sections.work.summary }] : []),
  ...(hasAbout ? [{ label: "About", href: "#about", hint: profile.focusAreas.join(", ") || undefined }] : []),
  ...(profile.principles.length ? [{ label: "Principles", href: "#principles", hint: sections.principles.summary }] : []),
  ...(profile.experience.length ? [{ label: "Experience", href: "#experience", hint: sections.experience.summary }] : []),
  ...(profile.education.length ? [{ label: "Education", href: "#education", hint: sections.education.summary }] : []),
  ...(profile.talks.length ? [{ label: "Talks", href: "#talks", hint: sections.talks.summary }] : []),
];

const links = contact.links.map(({ label, href }) => ({ label, href }));

const lowerFirst = (s: string) => s.charAt(0).toLowerCase() + s.slice(1);
---

<main>
  <header class="hero">
    <div class="swap pixel name">
      <h1>{profile.name.toUpperCase()}</h1>
      <div class="muted" aria-hidden="true">{profile.handle.toUpperCase()}</div>
    </div>
    <div class="hero-bar">
      <div class="swap pixel tagline">
        <p>{profile.headline}</p>
        <p class="muted" aria-hidden="true">{current.label}.</p>
      </div>
      <button id="raw-scheme-toggle" class="pixel scheme-toggle" type="button" aria-label="Toggle dark mode">
        <span class="when-light">DARK</span><span class="when-dark">LIGHT</span>
      </button>
    </div>
    <div class="rule"></div>
  </header>

  <section class="intro">
    <div class="intro-text">
      <p>
        {profile.intro}<br />
        I'm {lowerFirst(current.title)} of {current.href ? <a href={current.href}>{current.org}</a> : current.org}{
          current.orgDetail && ` (${current.orgDetail})`
        }{current.highlight ? `, where ${lowerFirst(current.highlight)}` : "."}<br />
        {profile.about.facts.join(" ")}
      </p>

      <nav aria-label="Sections" class="nav">
        {
          nav.map((item) => (
            <a href={item.href} class="nav-link">
              <span class="nav-label">{item.label}</span>
              <span aria-hidden="true">→</span>
              {item.hint && <span class="nav-hint muted">{item.hint}</span>}
            </a>
          ))
        }
      </nav>

      <ul class="links">
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </div>

    <figure class="art">
      <Image {...hero} loading="eager" fetchpriority="high" />
    </figure>
  </section>

  {
    profile.numbers.length > 0 && (
      <>
        <div class="rule-thick" />
        <dl class="numbers">
          {profile.numbers.map((n) => (
            <div class="number">
              <dt class="pixel">{n.value}</dt>
              <dd class="meta">{n.label}</dd>
            </div>
          ))}
        </dl>
      </>
    )
  }

  {
    projects.length > 0 && (
      <>
        <div class="rule-thick" />
        <section id="projects" class="section">
          <div class="section-head">
            <h2 class="pixel">PROJECTS</h2>
            <p>{projectCount}.</p>
          </div>
          <ol class="rows">
            {projects.map((p) => {
              const isWork = p.id === company?.id && work.length > 0;
              const facts = [
                { label: "Stack", value: p.stack.join(" · ") },
                { label: "Tags", value: p.tags.map((t) => `#${t}`).join(" ") },
              ].filter((f) => f.value);
              return (
                <li class="row" id={p.anchor} data-raw-project>
                  <details class="entry">
                    <summary class="head">
                      <span class="key">
                        <span>{p.period}</span>
                        <span class="chip pixel" data-status={p.status}>
                          {p.statusLabel.toUpperCase()}
                        </span>
                      </span>
                      <h3 class="title">{p.title}</h3>
                      <span class="sub">{p.role}</span>
                      <span class="line">{p.summary}</span>
                      <span class="toggle pixel" aria-hidden="true" />
                    </summary>
                    <div class="more">
                      {p.dek !== p.summary && <p>{p.dek}</p>}
                      {p.hasBody && <div class="prose" set:html={p.html} />}
                      {isWork ? (
                        <p class="meta">
                          Work streams: <a href="#work">see Work</a>.
                        </p>
                      ) : (
                        p.highlights.length > 0 && (
                          <ol class="sublist">
                            {p.highlights.map((h) => (
                              <li>
                                <h4 class="title">{h.title}</h4>
                                <p>{h.body}</p>
                                {h.result && <p class="title result">{h.result}</p>}
                                {h.stack.length > 0 && <p class="meta">{h.stack.join(" · ")}</p>}
                              </li>
                            ))}
                          </ol>
                        )
                      )}
                      {(facts.length > 0 || p.links.length > 0) && (
                        <dl class="facts">
                          {facts.map((f) => (
                            <div>
                              <dt class="meta">{f.label}</dt>
                              <dd>{f.value}</dd>
                            </div>
                          ))}
                          {p.links.length > 0 && (
                            <div>
                              <dt class="meta">Links</dt>
                              <dd>
                                {p.links.map((link, i) => (
                                  <>
                                    {i > 0 && " · "}
                                    <a href={link.href}>
                                      {link.label}
                                      <span aria-hidden="true"> ↗</span>
                                    </a>
                                  </>
                                ))}
                              </dd>
                            </div>
                          )}
                        </dl>
                      )}
                    </div>
                  </details>
                </li>
              );
            })}
          </ol>
        </section>
      </>
    )
  }

  {
    work.length > 0 && (
      <>
        <div class="rule-thick" />
        <section id="work" class="section">
          <div class="section-head">
            <h2 class="pixel">WORK</h2>
            {sections.work.intro && <p>{sections.work.intro}</p>}
          </div>
          <ol class="rows">
            {work.map((item, i) => (
              <li class="row">
                <details class="entry">
                  <summary class="head">
                    <span class="key">{pad(i + 1, 2)}</span>
                    <h3 class="title">{item.title}</h3>
                    <span class="toggle pixel" aria-hidden="true" />
                  </summary>
                  <div class="more">
                    <p>{item.body}</p>
                    {item.result && <p class="title result">{item.result}</p>}
                    {item.stack.length > 0 && <p class="meta">{item.stack.join(" · ")}</p>}
                  </div>
                </details>
              </li>
            ))}
          </ol>
        </section>
      </>
    )
  }

  {
    hasAbout && (
      <>
        <div class="rule-thick" />
        <section id="about" class="section">
          <div class="section-head">
            <h2 class="pixel">ABOUT</h2>
            {profile.quote && (
              <figure class="quote">
                <blockquote class="pixel">
                  <p>{profile.quote.text}</p>
                </blockquote>
                {profile.quote.context && <figcaption class="meta">{profile.quote.context}</figcaption>}
              </figure>
            )}
          </div>
          <ul class="rows">
            {profile.about.long.length > 0 && (
              <li class="row">
                <details class="entry">
                  <summary class="head">
                    <span class="key">Bio</span>
                    <span class="line">{profile.about.short}</span>
                    <span class="toggle pixel" aria-hidden="true" />
                  </summary>
                  <div class="more">
                    {profile.about.long.map((para) => (
                      <p>{para}</p>
                    ))}
                  </div>
                </details>
              </li>
            )}
            {profile.focusAreas.length > 0 && (
              <li class="row">
                <div class="head">
                  <span class="key">Focus</span>
                  <span class="line">{profile.focusAreas.join(" · ")}</span>
                </div>
              </li>
            )}
            {profile.stack.map((g) => (
              <li class="row">
                <div class="head">
                  <span class="key">{g.label}</span>
                  <span class="line">{g.items.join(" · ")}</span>
                </div>
              </li>
            ))}
          </ul>
        </section>
      </>
    )
  }

  {
    profile.principles.length > 0 && (
      <>
        <div class="rule-thick" />
        <section id="principles" class="section">
          <div class="section-head">
            <h2 class="pixel">PRINCIPLES</h2>
            {sections.principles.intro && <p>{sections.principles.intro}</p>}
          </div>
          <ol class="rows">
            {profile.principles.map((p) => (
              <li class="row">
                <details class="entry">
                  <summary class="head">
                    <span class="key">{p.no2}</span>
                    <h3 class="title">{p.title}</h3>
                    <span class="toggle pixel" aria-hidden="true" />
                  </summary>
                  <div class="more">
                    <p>{p.body}</p>
                  </div>
                </details>
              </li>
            ))}
          </ol>
        </section>
      </>
    )
  }

  {
    profile.experience.length > 0 && (
      <>
        <div class="rule-thick" />
        <section id="experience" class="section">
          <div class="section-head">
            <h2 class="pixel">EXPERIENCE</h2>
            {sections.experience.intro && <p>{sections.experience.intro}</p>}
          </div>
          <ol class="rows">
            {profile.experience.map((org) => (
              <li class="row" id={org.anchor}>
                <details class="entry">
                  <summary class="head">
                    <span class="key">{org.years}</span>
                    <h3 class="title">{org.org}</h3>
                    <span class="sub">{org.roles.map((r) => r.title).join(" · ")}</span>
                    <span class="toggle pixel" aria-hidden="true" />
                  </summary>
                  <div class="more">
                    {org.details.length > 0 && <p class="meta">{org.details.join(" · ")}</p>}
                    {org.summary && <p>{org.summary}</p>}
                    <ol class="sublist rail">
                      {org.roles.map((role) => (
                        <li>
                          <h4 class="title">
                            {role.title} <span class="meta">· {role.typeLabel}</span>
                          </h4>
                          <p class="meta">
                            <time datetime={role.start.iso}>{role.start.label}</time> –{" "}
                            {role.end ? <time datetime={role.end.iso}>{role.end.label}</time> : "present"}
                            {!role.current && <span class="nowrap"> · {role.duration}</span>}
                          </p>
                          {role.text && <p>{role.text}</p>}
                          {role.highlights.map((h) => (
                            <p class="arrow">{h}</p>
                          ))}
                          {role.skills.length > 0 && <p class="meta">{role.skills.join(" · ")}</p>}
                        </li>
                      ))}
                    </ol>
                    {org.project && (
                      <p class="meta">
                        <a href={`#${org.project.anchor}`}>See the {org.project.title} project ↑</a>
                      </p>
                    )}
                  </div>
                </details>
              </li>
            ))}
          </ol>
        </section>
      </>
    )
  }

  {
    profile.education.length > 0 && (
      <>
        <div class="rule-thick" />
        <section id="education" class="section">
          <div class="section-head">
            <h2 class="pixel">EDUCATION</h2>
            {sections.education.intro && <p>{sections.education.intro}</p>}
          </div>
          <ol class="rows">
            {profile.education.map((e) => (
              <li class="row" id={e.anchor}>
                <div class="head">
                  <span class="key">{e.years}</span>
                  <h3 class="title">{e.school}</h3>
                  <span class="sub">{e.program}</span>
                </div>
              </li>
            ))}
          </ol>
        </section>
      </>
    )
  }

  {
    profile.talks.length > 0 && (
      <>
        <div class="rule-thick" />
        <section id="talks" class="section">
          <div class="section-head">
            <h2 class="pixel">TALKS</h2>
            {sections.talks.intro && <p>{sections.talks.intro}</p>}
          </div>
          <ul class="rows">
            {profile.talks.map((t) => (
              <li class="row">
                <div class="head">
                  <span class="key">{t.year ?? ""}</span>
                  <span class="title">{t.text}</span>
                </div>
              </li>
            ))}
          </ul>
        </section>
      </>
    )
  }

  <footer>
    <div class="rule"></div>
    <div class="footer-inner" data-switcher-avoid>
      <p>
        {contact.intro && <>{contact.intro} </>}<a href={contact.preferred.href} rel="me noopener">Message me on {contact.preferred.label}</a>.
      </p>
      <p class="muted colophon">
        Set in Tiny5 and iA Writer Mono.{
          credit && (
            <>
              {" "}Image after {credit.artist}, <i>{credit.title}</i> ({credit.year}).
            </>
          )
        }<span class="agents">
          {" "}Also in Markdown: <a href={llmsTxt} type="text/plain" title="This site as Markdown, for AI agents">llms.txt</a>.
        </span>
      </p>
    </div>
  </footer>
</main>

<style>
  main {
    padding: 48px var(--gutter) 64px;
  }

  /* Sized so the 17-character name fills the line without wrapping. */
  .name {
    font-size: clamp(2rem, 9.4vw, 11rem);
    /* Leaves room above the cap height for the accent on É. */
    line-height: 1.2;
  }

  .name h1 {
    font-size: inherit;
    font-weight: 400;
    white-space: nowrap;
  }

  .hero-bar {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
    margin: 16px 0;
  }

  .tagline {
    font-size: clamp(1.125rem, 2.6vw, 2.25rem);
    line-height: 1.2;
  }

  .scheme-toggle {
    background: none;
    border: 0;
    color: var(--muted);
    cursor: pointer;
    font-size: 0.875rem;
    padding: 4px 0;
  }

  .scheme-toggle:hover {
    color: var(--fg);
  }

  :root[data-raw-scheme="dark"] .when-light,
  :root:not([data-raw-scheme="dark"]) .when-dark {
    display: none;
  }

  .intro {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding: 32px 0;
  }

  .intro-text {
    display: flex;
    flex-direction: column;
    gap: 40px;
    padding: 0 8px;
  }

  .nav {
    display: flex;
    flex-direction: column;
  }

  .nav-link {
    display: flex;
    align-items: baseline;
    gap: 8px;
    padding: 6px 0;
    font-size: 0.875rem;
    text-decoration: none;
  }

  .nav-link:hover .nav-label {
    text-decoration: underline;
  }

  .nav-hint {
    opacity: 0;
    transition: opacity 150ms;
  }

  .nav-link:hover .nav-hint,
  .nav-link:focus-visible .nav-hint {
    opacity: 1;
  }

  @media (hover: none) {
    .name h1 {
      font-size: clamp(2rem, 17vw, 5rem);
      white-space: normal;
      line-height: 1.1;
    }

    .nav-hint {
      display: none;
    }
  }

  .links {
    display: flex;
    gap: 24px;
    font-size: 0.875rem;
  }

  .links a {
    text-decoration: none;
  }

  .links a:hover {
    text-decoration: underline;
  }

  .art {
    border: 4px solid var(--fg);
    border-radius: 4px;
    overflow: hidden;
    align-self: flex-start;
    max-width: 560px;
    background: var(--fog);
  }

  .numbers {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 24px 16px;
    padding: 32px 8px;
  }

  .number dt {
    font-size: clamp(2rem, 4vw, 3.5rem);
    line-height: 1.1;
  }

  .number dd {
    font-size: 0.875rem;
    margin-top: 8px;
    max-width: 24ch;
  }

  /*
   * Type: five styles, one per kind of text.
   *   Display  Tiny5, sized per use: name, tagline, section titles, figures, quote, status chips, toggles.
   *   Lead     iA Writer Mono 1rem/400: the introduction under the name.
   *   Title    0.875rem/700: what an item is called (project, stream, principle, organization, role, school, talk).
   *   Body     0.875rem/400: what it says (summaries, descriptions, prose, section intros).
   *   Meta     0.875rem/400 muted: keys (periods, years, numbers, labels) and secondary facts (role, program,
   *            organization details, stack, tags, captions, colophon).
   * Rules: 4px under the header, 8px between sections, 2px around each list and on the rail, 1px between rows.
   */
  .section {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding: 32px 0 56px;
  }

  .section-head {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding: 0 8px;
  }

  .section-head h2 {
    font-size: clamp(2.5rem, 5vw, 3.75rem);
    line-height: 1;
  }

  .section-head p {
    font-size: 0.875rem;
    max-width: 480px;
  }

  .title {
    font-size: 0.875rem;
    font-weight: 700;
  }

  .meta {
    color: var(--muted);
    font-size: 0.875rem;
    font-weight: 400;
  }

  .nowrap {
    white-space: nowrap;
  }

  /*
   * Lists: every item is one row on one grid, key · main · toggle. The main column stacks the title, a secondary
   * line (meta) and a one-line text (body); an item shows the slots it has, always in that order. Whatever else the
   * item holds is in a native <details> under the row, aligned on the main column.
   */
  .rows {
    --key: 13ch;
    --toggle: 2ch;
    font-size: 0.875rem;
    border-top: 2px solid var(--fg);
    border-bottom: 2px solid var(--fg);
  }

  .row + .row {
    border-top: 1px solid var(--fg);
  }

  .head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--toggle);
    grid-template-areas:
      "key toggle"
      "title title"
      "sub sub"
      "line line";
    column-gap: 16px;
    padding: 12px 8px;
  }

  .key {
    grid-area: key;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    align-self: start;
    gap: 4px 12px;
    color: var(--muted);
  }

  .head .title {
    grid-area: title;
  }

  .sub {
    grid-area: sub;
    color: var(--muted);
  }

  .line {
    grid-area: line;
    overflow-wrap: anywhere;
  }

  .toggle {
    grid-area: toggle;
    justify-self: end;
    align-self: start;
    font-size: 1.25rem;
    line-height: 1.1;
  }

  .toggle::before {
    content: "+" / "";
  }

  .entry[open] > summary .toggle::before {
    content: "−" / "";
  }

  .entry > summary {
    cursor: pointer;
    list-style: none;
  }

  .entry > summary::-webkit-details-marker {
    display: none;
  }

  .entry > summary:focus-visible {
    outline-offset: -2px;
  }

  @media (hover: hover) {
    .entry > summary:hover :is(.title, .line) {
      text-decoration: underline;
      text-underline-offset: 4px;
    }
  }

  .row:has(> .entry[open]) {
    background: var(--card);
  }

  .more {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 0 8px 20px;
  }

  @media (min-width: 640px) {
    .head {
      grid-template-columns: var(--key) minmax(0, 1fr) var(--toggle);
      grid-template-areas:
        "key title toggle"
        "key sub toggle"
        "key line toggle";
    }

    /* A key alone (about's rows) still lines up with the titles. */
    .key {
      flex-direction: column;
      align-items: flex-start;
    }

    .more {
      padding-left: calc(8px + var(--key) + 16px);
      padding-right: calc(8px + var(--toggle) + 16px);
    }
  }

  .chip {
    padding: 0 6px;
    border: 2px solid var(--fg);
    color: var(--fg);
    line-height: 1.4;
  }

  .chip[data-status="shipped"] {
    background: var(--fg);
    color: var(--bg);
  }

  .result::before,
  .arrow::before {
    content: "→ " / "";
  }

  .prose :global(p + p) {
    margin-top: 0.8em;
  }

  /* Inside an item: its own parts (work streams, roles), each led by a title, behind a rail. */
  .sublist {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .sublist li {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .rail {
    padding-left: 14px;
    border-left: 2px solid var(--fg);
  }

  .facts div {
    display: grid;
    grid-template-columns: 7ch minmax(0, 1fr);
    gap: 16px;
  }

  /* About */
  .quote {
    padding: 0 8px;
  }

  .section-head .quote p {
    max-width: 16ch;
    padding: 0;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    line-height: 1.15;
  }

  .quote figcaption {
    margin-top: 12px;
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 24px 8px 0;
    font-size: 0.875rem;
  }

  @media (min-width: 640px) {
    .numbers {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .intro,
    .section {
      flex-direction: row;
    }

    .intro-text,
    .section-head,
    .rows {
      flex: 1;
      min-width: 0;
    }

    .quote {
      padding: 48px 0 0 48px;
    }

