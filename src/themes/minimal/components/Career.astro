---
/**
 * Experience and Education, as tables on the project index's columns.
 * Experience: No. · Organization · Role · Type · Period, one line per organization (the latest title, "+n" when
 * there were more). The row opens the same panel for every organization: its summary and every role (title, type,
 * dates, text, highlights) under the name, its facts (details, skills, links) under the descriptor.
 * Education: No. · School · Program · Period, plain rows (there is nothing more to open).
 */
import type { Profile } from "../../../lib/portfolio";
import { pad } from "../../../lib/portfolio";
import Disclosure from "./Disclosure.astro";

interface Props {
  profile: Profile;
}

const { experience, education } = Astro.props.profile;
---

{
  experience.length > 0 && (
    <section id="experience" class="mn-section mn-wrap" aria-labelledby="experience-title">
      <h2 id="experience-title" class="mn-label">Experience</h2>

      <ol class="mn-table" role="list" data-mn-disclosures>
        {experience.map((org) => {
          const [latest] = org.roles;
          const earlier = org.roles.length - 1;
          return (
            <Disclosure id={org.anchor}>
              <Fragment slot="row">
                <span class="mn-no">{pad(org.index + 1, 2)}</span>
                <span class="mn-name">{org.org}</span>
                <span class="mn-desc">
                  <span class="sr-only">, </span>
                  {latest.title}
                  {earlier > 0 && (
                    <span class="more">
                      <span aria-hidden="true"> +{earlier}</span>
                      <span class="sr-only">
                        , and {earlier} earlier {earlier === 1 ? "role" : "roles"}
                      </span>
                    </span>
                  )}
                </span>
                <span class="mn-meta">
                  <span class="mn-cat">
                    <span class="sr-only">, </span>
                    {latest.typeLabel}
                  </span>
                  <span class="mn-when">
                    <span class="sr-only">, </span>
                    {org.years}
                  </span>
                </span>
              </Fragment>

              <div class="mn-p-text">
                {org.summary && <p class="mn-lead">{org.summary}</p>}
                <ol class="roles" role="list">
                  {org.roles.map((role) => (
                    <li class="role">
                      <h4 class="role-title mn-body">{role.title}</h4>
                      <p class="role-when mn-small">
                        {role.typeLabel} · <time datetime={role.start.iso}>{role.start.label}</time> –{" "}
                        {role.end ? <time datetime={role.end.iso}>{role.end.label}</time> : "present"}
                        {!role.current && ` · ${role.duration}`}
                      </p>
                      {role.text && <p class="role-text">{role.text}</p>}
                      {role.highlights.length > 0 && (
                        <ul class="hl" role="list">
                          {role.highlights.map((h) => (
                            <li>{h}</li>
                          ))}
                        </ul>
                      )}
                    </li>
                  ))}
                </ol>
              </div>

              {(org.details.length > 0 || org.skills.length > 0 || org.href || org.project) && (
                <dl class="mn-facts">
                  {org.details.length > 0 && (
                    <div>
                      <dt>Details</dt>
                      <dd>{org.details.join(", ")}</dd>
                    </div>
                  )}
                  {org.skills.length > 0 && (
                    <div>
                      <dt>Skills</dt>
                      <dd>{org.skills.join(", ")}</dd>
                    </div>
                  )}
                  {(org.href || org.project) && (
                    <div>
                      <dt>Links</dt>
                      <dd class="mn-links">
                        {org.href && (
                          <a class="mn-link" href={org.href}>
                            {new URL(org.href).hostname.replace(/^www\./, "")}
                            <span aria-hidden="true"> ↗</span>
                          </a>
                        )}
                        {org.project && (
                          <a class="mn-link" href={`#${org.project.anchor}`}>
                            {org.project.title} in the index
                            <span aria-hidden="true"> ↑</span>
                          </a>
                        )}
                      </dd>
                    </div>
                  )}
                </dl>
              )}
            </Disclosure>
          );
        })}
      </ol>
    </section>
  )
}

{
  education.length > 0 && (
    <section id="education" class="mn-section mn-wrap" aria-labelledby="education-title">
      <h2 id="education-title" class="mn-label">Education</h2>

      <ol class="mn-table" role="list">
        {education.map((e) => (
          <li class="mn-item" id={e.anchor}>
            <div class="mn-row mn-grid mn-reveal">
              <span class="mn-no">{pad(e.index + 1, 2)}</span>
              <h3 class="mn-name">
                {e.href ? (
                  <a class="mn-link" href={e.href}>
                    {e.school}
                  </a>
                ) : (
                  e.school
                )}
              </h3>
              <p class="mn-desc">
                <span class="sr-only">, </span>
                {e.program}
              </p>
              <span class="mn-meta">
                <span class="mn-when">
                  <span class="sr-only">, </span>
                  {e.years}
                </span>
              </span>
            </div>
          </li>
        ))}
      </ol>
    </section>
  )
}

<style>
  .more {
    font-size: var(--t-small);
    color: var(--mute);
  }

  .roles {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mn-lead + .roles {
    margin-top: 20px;
  }

  .role + .role {
    margin-top: 20px;
  }

  .role > * {
    margin: 0;
  }

  .role-title {
    color: var(--ink);
  }

  .role-when {
    color: var(--mute);
  }

  .role > * + * {
    margin-top: 4px;
  }

  .role-text,
  .hl {
    margin-top: 8px;
  }

  .hl {
    padding: 0;
    list-style: none;
  }

  .hl li {
    position: relative;
    padding-left: 22px;
  }

  .hl li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.78em;
    width: 12px;
    height: 1px;
    background: currentColor;
  }

  .hl li + li {
    margin-top: 4px;
  }
</style>
