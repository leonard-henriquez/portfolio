---
/** Talks, juries and recognition: No. · what · year, on the table grid. Nothing more to open, so plain rows. */
import type { Profile } from "../../../lib/portfolio";
import { pad } from "../../../lib/portfolio";

interface Props {
  talks: Profile["talks"];
}

const { talks } = Astro.props;
---

{
  talks.length > 0 && (
    <section id="talks" class="mn-section mn-wrap" aria-labelledby="talks-title">
      <h2 id="talks-title" class="mn-label">Talks &amp; juries</h2>
      <ol class="mn-table" role="list">
        {talks.map((t, i) => (
          <li class="mn-item">
            <div class="mn-row mn-grid mn-reveal">
              <span class="mn-no">{pad(i + 1, 2)}</span>
              <p class="mn-name mn-name--wide">{t.text}</p>
              {t.year && (
                <span class="mn-meta">
                  <span class="mn-when">
                    <time datetime={String(t.year)}>{t.year}</time>
                  </span>
                </span>
              )}
            </div>
          </li>
        ))}
      </ol>
    </section>
  )
}
