---
import type { Profile } from "../../../lib/portfolio";

interface Props {
  talks: Profile["talks"];
}

const { talks } = Astro.props;
---

{
  talks.length > 0 && (
    <section class="record mn-wrap mn-grid" aria-labelledby="talks-title">
      <h2 id="talks-title" class="mn-label">Talks &amp; juries</h2>
      <ul class="list" role="list">
        {talks.map((t) => (
          <li class="item mn-rule">
            <span class="when mn-reveal">
              {t.year ? <time datetime={String(t.year)}>{t.year}</time> : <span aria-hidden="true">—</span>}
            </span>
            <p class="talk mn-reveal">{t.text}</p>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .record {
    padding-top: clamp(96px, 11vw, 160px);
    row-gap: 24px;
  }

  .mn-label {
    grid-column: 1 / span 3;
  }

  .list {
    grid-column: 4 / -1;
    display: grid;
    grid-template-columns: subgrid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--rule);
  }

  .item {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    align-items: baseline;
    padding: 16px 0 18px;
    font-size: 15px;
    line-height: 1.55;
  }

  .when {
    grid-column: 1;
    font-size: 14px;
    color: var(--mute);
    white-space: nowrap;
  }

  .talk {
    grid-column: 2 / span 8;
    margin: 0;
  }

  @media (max-width: 1099px) {
    .mn-label,
    .list {
      grid-column: 1 / -1;
    }

    .when {
      grid-column: 1 / span 2;
    }

    .talk {
      grid-column: 3 / -1;
    }
  }

  @media (max-width: 760px) {
    .item {
      grid-template-columns: 5.75rem minmax(0, 1fr);
      column-gap: 0;
      row-gap: 4px;
    }

    .when {
      grid-column: 1;
    }

    .talk {
      grid-column: 2;
    }
  }
</style>
