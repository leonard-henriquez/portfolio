---
import { Picture } from "astro:assets";
import type { Portfolio } from "../../../lib/portfolio";
import { asPhrase, joinList, lowerFirst, stripEnd, words } from "../format";
import { heroImage } from "../hero";

interface Props {
  portfolio: Portfolio;
}

const { profile } = Astro.props.portfolio;
// Shared with meta.ts, which preloads exactly this image.
const hero = heroImage(Astro.props.portfolio);

// "Founder and engineer." in ink, then the headline and focus areas in grey.
const lead = `${joinList(asPhrase(profile.roles))}.`;
const focus = profile.focusAreas.map(lowerFirst);
const tail = focus.length ? `${stripEnd(profile.headline)} — ${focus.join(", ")}.` : profile.headline;
const { current } = profile;
---

<section id="top" class="hero mn-wrap" aria-labelledby="hero-title">
  <h1 id="hero-title" class="headline mn-display" data-mn-headline>
    <span class="sr-only">{lead} {tail}</span>
    <span aria-hidden="true">
      <span class="lead">{words(lead).map((w) => <><span class="w"><span>{w}</span></span>{" "}</>)}</span>
      <span class="tail">{words(tail).map((w) => <><span class="w"><span>{w}</span></span>{" "}</>)}</span>
    </span>
  </h1>
</section>

<figure class="figure mn-wrap" data-mn-hero>
  <div class="media">
    <div class="zoom">
      <div class="drift">
        <Picture {...hero} loading="eager" fetchpriority="high" />
      </div>
    </div>
  </div>
  <figcaption class="caption mn-grid">
    <span class="cap-label">Currently</span>
    <span class="cap-role">
      {current.title}, {current.href ? <a class="mn-link" href={current.href}>{current.org}</a> : current.org}
      {current.orgDetail && ` (${current.orgDetail})`}
      <span class="cap-place">· {profile.location.label}</span>
    </span>
    <span class="cap-period">{current.since}–present</span>
  </figcaption>
</figure>

<style>
  .hero {
    padding-block: clamp(72px, 10vw, 144px) clamp(48px, 6vw, 88px);
  }

  .headline {
    margin: 0;
    max-width: 19ch;
    text-wrap: pretty;
  }

  .tail {
    color: var(--mute-lg);
  }

  /* Each word sits in a clipped box so it can rise into place. Padding keeps descenders and accents unclipped. */
  .w {
    display: inline-block;
    padding: 0.1em 0 0.14em;
    margin: -0.1em 0 -0.14em;
    clip-path: inset(0 -0.06em);
  }

  .w > span {
    display: inline-block;
  }

  .media {
    position: relative;
    aspect-ratio: 21 / 9;
    overflow: clip;
    background: #eceeef;
    view-timeline: --mn-hero block;
  }

  .zoom,
  .drift {
    position: absolute;
    inset: 0;
  }

  .drift {
    inset: -6% 0;
  }

  .drift :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .caption {
    margin-top: 12px;
    font-size: var(--t-small);
    line-height: 1.45;
    color: var(--mute);
  }

  .cap-label {
    grid-column: 1 / span 3;
  }

  .cap-role {
    grid-column: 4 / span 6;
    color: var(--ink);
  }

  .cap-place {
    color: var(--mute);
  }

  .cap-period {
    grid-column: 10 / span 3;
    text-align: right;
  }

  @media (max-width: 760px) {
    .media {
      aspect-ratio: 4 / 3;
    }

    .cap-label {
      display: none;
    }

    .cap-role {
      grid-column: 1 / span 3;
    }

    .cap-period {
      grid-column: 4 / span 1;
      white-space: nowrap;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    /*
     * Load sequence, from first paint (it never waits for client.ts): words rise line by line (`--l`, the word's
     * line, is set by meta.ts's boot just before first paint), then the photo wipes open from the top once it has
     * loaded (`mn-hero-ready`, also set by the boot, at most 1 s after first paint). Animations, not transitions,
     * so they play whenever their class arrives, even before first paint.
     */
    :global(.mn-js) .w > span {
      animation: mn-word-rise 0.6s var(--ease-out) calc(var(--l, 0) * 35ms) both;
    }

    :global(.mn-js) .media {
      clip-path: inset(0 0 100% 0);
    }

    :global(.mn-js) .zoom {
      transform: scale(1.14);
    }

    :global(.mn-js) .caption {
      opacity: 0;
      transform: translateY(8px);
    }

    :global(.mn-js.mn-hero-ready) .media {
      animation: mn-wipe 1.2s var(--ease-io) 0.1s both;
    }

    :global(.mn-js.mn-hero-ready) .zoom {
      animation: mn-unzoom 1.9s var(--ease-out) 0.1s both;
    }

    :global(.mn-js.mn-hero-ready) .caption {
      animation: mn-caption-in 0.9s var(--ease-out) 0.8s both;
    }

    @supports (animation-timeline: view()) {
      .drift {
        animation: mn-drift linear both;
        animation-timeline: --mn-hero;
        animation-range: cover 0% cover 100%;
      }
    }
  }

  @keyframes mn-word-rise {
    from {
      transform: translateY(108%);
    }
  }

  @keyframes mn-wipe {
    from {
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0);
    }
  }

  @keyframes mn-unzoom {
    from {
      transform: scale(1.14);
    }
    to {
      transform: none;
    }
  }

  @keyframes mn-caption-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes mn-drift {
    from {
      transform: translateY(-5%);
    }
    to {
      transform: translateY(5%);
    }
  }
</style>
