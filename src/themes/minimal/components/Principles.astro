---
/** Principles: No. · title, one line each; the explanation opens on demand. */
import type { Profile } from "../../../lib/portfolio";
import Disclosure from "./Disclosure.astro";

interface Props {
  principles: Profile["principles"];
}

const { principles } = Astro.props;
---

{
  principles.length > 0 && (
    <section id="principles" class="mn-section mn-wrap" aria-labelledby="principles-title">
      <h2 id="principles-title" class="mn-label">Principles</h2>
      <ol class="mn-table" role="list" data-mn-disclosures>
        {principles.map((p) => (
          <Disclosure id={`principle-${p.no2}`}>
            <Fragment slot="row">
              <span class="mn-no">{p.no2}</span>
              <span class="mn-name mn-name--wide">{p.title}</span>
            </Fragment>
            <div class="mn-p-text">
              <p>{p.body}</p>
            </div>
          </Disclosure>
        ))}
      </ol>
    </section>
  )
}
