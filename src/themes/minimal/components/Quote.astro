---
import type { Profile } from "../../../lib/portfolio";

interface Props {
  quote: Profile["quote"];
}

const { quote } = Astro.props;
---

{
  quote && (
    <figure class="quote mn-wrap mn-grid" aria-labelledby="quote-title">
      <h2 id="quote-title" class="mn-label">
        Motto
      </h2>
      <blockquote class="mn-reveal">
        <p>{quote.text}</p>
      </blockquote>
      {quote.context && <figcaption class="mn-reveal">{quote.context}</figcaption>}
    </figure>
  )
}

<style>
  .quote {
    margin: 0;
    padding-top: clamp(96px, 11vw, 160px);
    row-gap: 16px;
  }

  .mn-label {
    grid-column: 1 / span 3;
  }

  blockquote {
    grid-column: 4 / -1;
    margin: 0;
    font-size: clamp(36px, 4.6vw, 72px);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -0.035em;
  }

  blockquote p {
    margin: 0;
    max-width: 18ch;
    text-wrap: balance;
  }

  figcaption {
    grid-column: 4 / -1;
    font-size: 14px;
    color: var(--mute);
  }

  @media (max-width: 1099px) {
    .mn-label,
    blockquote,
    figcaption {
      grid-column: 1 / -1;
    }
  }
</style>
