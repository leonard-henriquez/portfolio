---
import type { Profile } from "../../../lib/portfolio";

interface Props {
  numbers: Profile["numbers"];
}

const { numbers } = Astro.props;
---

{
  numbers.length > 0 && (
    <section class="figures mn-wrap" aria-labelledby="figures-title">
      <div class="head mn-grid">
        <h2 id="figures-title" class="mn-label">Figures</h2>
      </div>
      <dl class="list" style={`--n: ${Math.min(numbers.length, 4)}`}>
        {numbers.map((n) => (
          <div class="fig mn-rule">
            <dt class="value">
              <span class="value-in mn-reveal">{n.value}</span>
            </dt>
            <dd class="caption mn-reveal" style="--range-end: 30%">
              {n.label}
            </dd>
          </div>
        ))}
      </dl>
    </section>
  )
}

<style>
  .figures {
    padding-top: clamp(96px, 11vw, 160px);
  }

  .head {
    padding-bottom: clamp(28px, 3vw, 40px);
  }

  .head .mn-label {
    grid-column: 1 / -1;
  }

  /* Four figures line up with the header's four columns; more wrap onto new rows. */
  .list {
    --rule-color: var(--ink);
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    gap: 40px var(--gap);
    margin: 0;
  }

  .fig {
    padding-top: 16px;
  }

  .value {
    margin: 0;
    padding-bottom: 0.08em;
    font-size: clamp(44px, 5.2vw, 80px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.045em;
    white-space: nowrap;
    clip-path: inset(0 -0.1em -0.2em 0);
  }

  .value-in {
    display: inline-block;
    --rise: 100%;
  }

  .caption {
    margin: 14px 0 0;
    max-width: 22ch;
    font-size: 14px;
    line-height: 1.45;
    color: var(--mute);
    text-wrap: pretty;
  }

  @media (max-width: 1099px) {
    .list {
      grid-template-columns: repeat(min(var(--n), 2), minmax(0, 1fr));
    }
  }
</style>
