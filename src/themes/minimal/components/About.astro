---
/**
 * About: the short version and the key figures; the long version, the stack and the motto open on demand.
 * The current role and focus areas are not repeated here: the hero says them.
 */
import type { Profile } from "../../../lib/portfolio";
import Disclosure from "./Disclosure.astro";

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;
const { about, numbers, stack, quote } = profile;
---

<section id="about" class="about mn-section mn-wrap" aria-labelledby="about-title">
  <h2 id="about-title" class="mn-label">About</h2>

  <div class="summary mn-grid">
    <p class="short mn-title mn-reveal">{about.short}</p>
    {
      numbers.length > 0 && (
        <dl class="figures mn-reveal" style={`--n: ${Math.min(numbers.length, 4)}`}>
          {numbers.map((n) => (
            <div class="fig">
              <dt class="value mn-title">{n.value}</dt>
              <dd class="caption mn-small">{n.label}</dd>
            </div>
          ))}
        </dl>
      )
    }
  </div>

  <ul class="mn-table more" role="list" data-mn-disclosures>
    <Disclosure id="about-more">
      <Fragment slot="row">
        <span class="toggle mn-small">More about me</span>
      </Fragment>

      <div class="mn-p-text">
        {about.long.map((p) => <p>{p}</p>)}
      </div>

      {
        (stack.length > 0 || quote) && (
          <dl class="mn-facts">
            {stack.map((group) => (
              <div>
                <dt>{group.label}</dt>
                <dd>{group.items.join(", ")}</dd>
              </div>
            ))}
            {quote && (
              <div>
                <dt>Motto</dt>
                <dd>
                  {quote.text}
                  {quote.context && <span class="context">{quote.context}</span>}
                </dd>
              </div>
            )}
          </dl>
        )
      }
    </Disclosure>
  </ul>
</section>

<style>
  /* The ink rule and the columns of the tables, so About reads on the same grid. */
  .summary {
    row-gap: 32px;
    padding: var(--row-pad) 0 calc(var(--row-pad) + 12px);
    border-top: 1px solid var(--ink);
  }

  .short {
    grid-column: 2 / span 8;
    margin: 0;
    max-width: 38em;
    text-wrap: pretty;
  }

  .figures {
    grid-column: 2 / span 8;
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    gap: 24px var(--gap);
    margin: 0;
  }

  .value {
    white-space: nowrap;
  }

  .caption {
    margin: 4px 0 0;
    max-width: 22ch;
    color: var(--mute);
    text-wrap: pretty;
  }

  /* The toggle row: a control, in the small style, on the name column. */
  ul.more {
    border-top-color: var(--rule);
  }

  .toggle {
    grid-column: 2 / span 8;
    grid-row: 1;
    color: var(--ink);
  }

  .more :global(.mn-plus) {
    top: calc(var(--row-pad) + var(--t-small) * 0.725 - 6px);
  }

  .context {
    display: block;
    color: var(--mute);
  }

  @media (max-width: 1099px) {
    .short,
    .figures,
    .toggle {
      grid-column: 2 / span 10;
    }

    .figures {
      grid-template-columns: repeat(min(var(--n), 2), minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .summary {
      grid-template-columns: 2.75rem minmax(0, 1fr);
      column-gap: 0;
    }

    .short,
    .figures,
    .toggle {
      grid-column: 2;
    }
  }
</style>
