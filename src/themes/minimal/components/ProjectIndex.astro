---
/**
 * The project index: No. · Project · Focus · Status · Year, one line per project. A row opens the project
 * (dek, description, a link to its own page, facts, image, highlights); on fine pointers a preview of its image follows the cursor.
 */
import type { Portfolio } from "../../../lib/portfolio";
import { pad } from "../../../lib/portfolio";
import Disclosure from "./Disclosure.astro";
import ProjectImage from "./ProjectImage.astro";

interface Props {
  portfolio: Portfolio;
}

const { projects } = Astro.props.portfolio;
---

<section id="projects" class="index mn-section mn-wrap" aria-labelledby="projects-title">
  <h2 id="projects-title" class="mn-label">Projects</h2>

  <ol class="mn-table" role="list" data-mn-disclosures data-mn-list>
    {
      projects.map((p) => (
        <Disclosure id={p.anchor} index={p.index}>
          <Fragment slot="row">
            <span class="mn-no">
              <span class="sr-only">No. </span>
              {p.no2}
            </span>
            <span class="mn-name">{p.shortTitle}</span>
            <span class="mn-desc">
              <span class="sr-only">, </span>
              {p.focus}
            </span>
            <span class="mn-meta">
              <span class="mn-cat">
                <span class="sr-only">, </span>
                {p.statusLabel}
              </span>
              <span class="mn-when">
                <span class="sr-only">, </span>
                {p.period}
              </span>
            </span>
          </Fragment>

          <div class="mn-p-text">
            {p.title !== p.shortTitle && <p class="p-title mn-small">{p.title}</p>}
            <p class="mn-lead">{p.dek}</p>
            {p.hasBody && (
              <div class="prose">
                <p.Content />
              </div>
            )}
            <p>
              <a class="mn-link p-page" href={p.href}>
                The project's page<span aria-hidden="true"> →</span>
              </a>
            </p>
          </div>

          <dl class="mn-facts">
            <div>
              <dt>Role</dt>
              <dd>{p.role}</dd>
            </div>
            {p.stack.length > 0 && (
              <div>
                <dt>Stack</dt>
                <dd>{p.stack.join(", ")}</dd>
              </div>
            )}
            {p.tags.length > 0 && (
              <div>
                <dt>Tags</dt>
                <dd>{p.tags.join(", ")}</dd>
              </div>
            )}
            {p.links.length > 0 && (
              <div>
                <dt>Links</dt>
                <dd class="mn-links">
                  {p.links.map((link) => (
                    <a class="mn-link" href={link.href}>
                      {link.label}
                      <span aria-hidden="true"> ↗</span>
                    </a>
                  ))}
                </dd>
              </div>
            )}
          </dl>

          <figure class="p-fig">
            <div class="p-frame">
              <ProjectImage
                image={p.image.photo}
                widths={[480, 720, 1080]}
                sizes="(min-width: 1100px) 22vw, (min-width: 761px) 30vw, calc(100vw - 32px)"
              />
            </div>
            <figcaption>
              <span>Fig. {p.no2}</span>
              <span>{p.image.photo.caption}</span>
            </figcaption>
          </figure>

          {p.highlights.length > 0 && (
            <div class="p-hl">
              <p class="p-hl-label">Highlights</p>
              <ol class="p-hl-list" role="list">
                {p.highlights.map((h, i) => (
                  <li class="hl">
                    <span class="hl-no" aria-hidden="true">
                      {pad(i + 1, 2)}
                    </span>
                    <h4 class="hl-title">{h.title}</h4>
                    <div class="hl-body">
                      <p>{h.body}</p>
                      {h.result && <p class="hl-result">{h.result}</p>}
                    </div>
                    {h.stack.length > 0 && <p class="hl-stack">{h.stack.join(", ")}</p>}
                  </li>
                ))}
              </ol>
            </div>
          )}
        </Disclosure>
      ))
    }
  </ol>

  <!-- Cursor-following preview for fine pointers. Duplicates the panel images, so it is hidden from assistive tech. -->
  <div class="preview" aria-hidden="true" data-mn-preview>
    <div class="pv-frame">
      {
        projects.map((p) => (
          <div class="pv-layer" data-index={p.index}>
            <ProjectImage image={p.image.photo} widths={[400, 720]} sizes="360px" alt="" class="pv-img" />
          </div>
        ))
      }
    </div>
    <div class="pv-caps">
      {
        projects.map((p) => (
          <p class="pv-cap" data-index={p.index}>
            <span>Fig. {p.no2}</span>
            <span>{p.image.photo.caption}</span>
          </p>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Only what is particular to projects; the table, the row and the panel grid are in global.css. */
  .p-title {
    color: var(--mute);
  }

  .p-page {
    color: var(--ink);
  }

  .prose :global(p) {
    margin: 0 0 0.9em;
    text-wrap: pretty;
  }

  .prose :global(p:last-child) {
    margin-bottom: 0;
  }

  .prose :global(a) {
    text-underline-offset: 0.18em;
    text-decoration-thickness: 1px;
  }

  .p-fig {
    grid-column: 10 / span 3;
    margin: 0;
  }

  .p-frame {
    aspect-ratio: 4 / 3;
    overflow: clip;
    background: #eceeef;
  }

  .p-frame :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .p-fig figcaption,
  .pv-cap {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin: 8px 0 0;
    font-size: var(--t-small);
    line-height: 1.45;
    color: var(--mute);
  }

  /* "Fig. 01" never breaks; a long caption (it falls back to the project title) wraps, or ellipsizes in the one-line preview. */
  .p-fig figcaption > :first-child,
  .pv-cap > :first-child {
    flex: none;
    white-space: nowrap;
  }

  .p-fig figcaption > :last-child {
    min-width: 0;
    text-align: right;
    text-wrap: balance;
  }

  .pv-cap > :last-child {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /*
   * Highlights: a nested table on the same columns: number under the No. column, title under the name,
   * body and stack under the descriptor. Its hairlines start at the name column (`--indent`), like the panel's text.
   */
  .p-hl {
    --indent: calc((100% - 11 * var(--gap)) / 12 + var(--gap));
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
  }

  .p-hl-label {
    grid-column: 2 / -1;
    margin: 0 0 12px;
    font-size: var(--t-small);
    line-height: 1.45;
    color: var(--mute);
  }

  .p-hl-list {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hl {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    align-items: baseline;
    padding: 12px 0 14px;
    background: linear-gradient(var(--rule), var(--rule)) right top / calc(100% - var(--indent)) 1px no-repeat;
    font-size: var(--t-body);
    line-height: 1.55;
  }

  .hl:last-child {
    background:
      linear-gradient(var(--rule), var(--rule)) right top / calc(100% - var(--indent)) 1px no-repeat,
      linear-gradient(var(--rule), var(--rule)) right bottom / calc(100% - var(--indent)) 1px no-repeat;
  }

  .hl-no {
    grid-column: 1;
    grid-row: 1;
    font-size: var(--t-small);
    line-height: 1.45;
    color: var(--mute);
  }

  .hl-title {
    grid-column: 2 / span 4;
    grid-row: 1;
    margin: 0;
    font-size: var(--t-body);
    font-weight: 400;
    color: var(--ink);
  }

  .hl-body {
    grid-column: 6 / span 4;
    grid-row: 1;
    color: var(--ink-2);
  }

  .hl-body p {
    margin: 0;
    text-wrap: pretty;
  }

  .hl-result {
    margin-top: 6px !important;
    color: var(--ink);
  }

  .hl-stack {
    grid-column: 6 / span 4;
    grid-row: 2;
    margin: 6px 0 0;
    font-size: var(--t-small);
    line-height: 1.45;
    color: var(--mute);
  }

  /* Preview */
  .preview {
    display: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .preview:global(.is-armed) {
      display: block;
      position: fixed;
      top: 0;
      left: 0;
      z-index: 25;
      width: clamp(240px, 22vw, 340px);
      pointer-events: none;
      will-change: transform;
    }
  }

  .pv-frame {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: clip;
    background: #eceeef;
    opacity: 0;
    transform: scale(0.92);
    transform-origin: 0 50%;
    transition:
      opacity 0.3s ease,
      transform 0.6s var(--ease-out);
  }

  .preview:global(.is-flip) .pv-frame {
    transform-origin: 100% 50%;
  }

  .preview:global(.is-visible) .pv-frame {
    opacity: 1;
    transform: none;
  }

  .pv-layer {
    position: absolute;
    inset: 0;
  }

  .pv-layer :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .pv-caps {
    position: relative;
    height: 28px;
    background: var(--paper);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .preview:global(.is-visible) .pv-caps {
    opacity: 1;
  }

  .pv-cap {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.25s ease;
  }

  .pv-cap:global(.is-active) {
    opacity: 1;
  }

  @media (max-width: 1099px) {
    .p-fig {
      grid-column: 9 / span 4;
      grid-row: 1 / span 2;
    }

    .hl-title {
      grid-column: 2 / -1;
    }

    .hl-body,
    .hl-stack {
      grid-column: 2 / span 7;
    }

    .hl-body {
      grid-row: 2;
      margin-top: 4px;
    }

    .hl-stack {
      grid-row: 3;
    }
  }

  @media (max-width: 760px) {
    .p-fig {
      grid-column: 2;
      grid-row: auto;
      order: -1;
    }

    /* Beats the panel's one-column rule (global.css): highlights keep their number column. */
    :global(.mn-panel-in) > .p-hl {
      --indent: 2.75rem;
      grid-column: 1 / -1;
    }

    .hl-title,
    .hl-body,
    .hl-stack {
      grid-column: 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pv-frame,
    .pv-cap,
    .pv-caps {
      transition: none;
    }
  }
</style>
