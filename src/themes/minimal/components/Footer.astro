---
import type { Profile } from "../../../lib/portfolio";

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;
const { email, mailto, links } = profile.contact;
const [local, domain = ""] = email.split("@");
// Character counts let the address fill the measure on one line (desktop) or two (mobile, broken at "@").
const chars = email.length + 2;
const charsNarrow = Math.max(local.length, domain.length + 1) + 2;
const year = new Date().getFullYear();
---

<footer id="contact" class="footer mn-rule" aria-labelledby="contact-title">
  <div class="mn-wrap">
    <div class="head mn-grid">
      <h2 id="contact-title" class="mn-label">Contact</h2>
      <p class="hint">Write to me</p>
    </div>

    <a class="mail" href={mailto} style={`--chars: ${chars}; --chars-narrow: ${charsNarrow}`}>
      <span class="mail-in mn-reveal">
        <span class="addr">{local}<wbr />@{domain}</span><span class="arrow" aria-hidden="true">↗</span>
      </span>
    </a>

    <div class="base mn-grid" data-switcher-avoid>
      <ul class="links" role="list">
        {
          links.map((link) => (
            <li>
              <a class="mn-link" href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="copy">© {year} {profile.name}</p>
      <p class="place">{profile.location.label}</p>
      <a class="top mn-link" href="#top">Back to top <span aria-hidden="true">↑</span></a>
    </div>
  </div>
</footer>

<style>
  .footer {
    --rule-color: var(--ink);
    margin-top: clamp(120px, 14vw, 200px);
  }

  .head {
    align-items: baseline;
    padding-top: 16px;
  }

  .head .mn-label {
    grid-column: 1 / span 3;
  }

  .hint {
    grid-column: 4 / span 3;
    margin: 0;
    font-size: 13px;
    color: var(--mute);
  }

  .mail {
    display: block;
    margin: clamp(40px, 6vw, 88px) 0 clamp(56px, 7vw, 104px);
    font-size: min(128px, calc((100vw - 2 * var(--gutter)) / (var(--chars) * 0.5)));
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.045em;
    text-decoration: none;
    white-space: nowrap;
    clip-path: inset(-0.1em -0.1em -0.2em -0.1em);
  }

  .mail-in {
    position: relative;
    display: inline-block;
    padding-bottom: 0.08em;
    --rise: 0.7em;
    --range-end: 30%;
  }

  /* Underline that draws in on hover. */
  .mail-in::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.02em;
    height: max(2px, 0.035em);
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.8s var(--ease-io);
  }

  .arrow {
    display: inline-block;
    margin-left: 0.12em;
    transition: transform 0.6s var(--ease-out);
  }

  .mail:hover .mail-in::after,
  .mail:focus-visible .mail-in::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .mail:hover .arrow,
  .mail:focus-visible .arrow {
    transform: translate(0.08em, -0.08em);
  }

  .base {
    align-items: baseline;
    padding-bottom: 40px;
    font-size: 14px;
    line-height: 1.4;
  }

  .links {
    grid-column: 1 / span 3;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .copy,
  .place {
    margin: 0;
    color: var(--mute);
  }

  .copy {
    grid-column: 4 / span 3;
  }

  .place {
    grid-column: 7 / span 3;
  }

  .top {
    grid-column: 10 / span 3;
    justify-self: end;
  }

  @media (max-width: 760px) {
    .hint {
      grid-column: 3 / span 2;
      text-align: right;
    }

    .mail {
      white-space: normal;
      font-size: min(17vw, calc((100vw - 2 * var(--gutter)) / (var(--chars-narrow) * 0.5)));
      line-height: 1.02;
    }

    .base {
      row-gap: 16px;
    }

    .links {
      grid-column: 1 / -1;
    }

    .copy {
      grid-column: 1 / span 2;
      grid-row: 2;
    }

    .place {
      display: none;
    }

    .top {
      grid-column: 3 / span 2;
      grid-row: 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mail-in::after,
    .arrow {
      transition: none;
    }
  }
</style>
