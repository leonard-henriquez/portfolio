---
import { MARKDOWN_PATHS } from "../../../lib/markdown";
import type { Profile } from "../../../lib/portfolio";

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;
const { intro, preferred, links } = profile.contact;
const year = new Date().getFullYear();
// For AI agents: the Markdown version of the site (src/lib/markdown.ts).
const llmsTxt = new URL(MARKDOWN_PATHS.index, Astro.site);
---

<footer id="contact" class="footer" aria-labelledby="contact-title">
  <div class="mn-wrap">
    <h2 id="contact-title" class="mn-label">Contact</h2>
    <div class="head mn-grid">
      <div class="body">
        {intro && <p class="pitch mn-title mn-reveal">{intro}</p>}
        <a class="cta mn-reveal" href={preferred.href} rel="me noopener" style="--range-end: 34%">
          Message me on {preferred.label}<span class="arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <div class="base mn-grid" data-switcher-avoid>
      <ul class="links" role="list">
        {
          links.map((link) => (
            <li>
              <a class="mn-link" href={link.href}>
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <a class="mn-link" href={llmsTxt} type="text/plain" title="This site as Markdown, for AI agents">llms.txt</a>
        </li>
      </ul>
      <p class="copy">© {year} {profile.name}</p>
      <p class="place">{profile.location.label}</p>
      <a class="top mn-link" href="#top">Back to top <span aria-hidden="true">↑</span></a>
    </div>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--section);
  }

  /* On the tables' grid: an ink rule, then the text on the name column. */
  .head {
    padding: var(--row-pad) 0 clamp(64px, 8vw, 112px);
    border-top: 1px solid var(--ink);
  }

  .body {
    grid-column: 2 / -1;
  }

  .pitch {
    max-width: 30em;
    margin: 0 0 28px;
    color: var(--mute);
    text-wrap: balance;
  }

  /* A button: ink block, paper text; the arrow lifts on hover. */
  .cta {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    padding: 14px 22px;
    background: var(--ink);
    color: var(--paper);
    font-size: var(--t-body);
    font-weight: 500;
    text-decoration: none;
    transition: background-color 0.3s var(--ease-out);
  }

  .arrow {
    display: inline-block;
    transition: transform 0.6s var(--ease-out);
  }

  .cta:hover,
  .cta:focus-visible {
    background: #333333;
  }

  .cta:hover .arrow,
  .cta:focus-visible .arrow {
    transform: translate(2px, -2px);
  }

  .base {
    align-items: baseline;
    padding-bottom: 40px;
    font-size: var(--t-small);
    line-height: 1.45;
  }

  .links {
    grid-column: 1 / span 3;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .copy,
  .place {
    margin: 0;
    color: var(--mute);
  }

  .copy {
    grid-column: 4 / span 3;
  }

  .place {
    grid-column: 7 / span 3;
  }

  .top {
    grid-column: 10 / span 3;
    justify-self: end;
  }

  @media (max-width: 760px) {
    .head {
      grid-template-columns: 2.75rem minmax(0, 1fr);
      column-gap: 0;
    }

    .body {
      grid-column: 2;
    }
  }

  @media (max-width: 760px) {
    .base {
      row-gap: 16px;
    }

    .links {
      grid-column: 1 / -1;
    }

    .copy {
      grid-column: 1 / span 2;
      grid-row: 2;
    }

    .place {
      display: none;
    }

    .top {
      grid-column: 3 / span 2;
      grid-row: 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta,
    .arrow {
      transition: none;
    }
  }
</style>
