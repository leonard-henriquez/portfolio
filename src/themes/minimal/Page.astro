---
/**
 * Minimal: Swiss minimal. One 12-column grid, Inter Tight with tabular figures,
 * a numbered project index with expandable rows and a cursor-following preview.
 * Document-level settings (theme colour, font preload, the pre-paint `boot`) live in `meta.ts`;
 * behaviour lives in `client.ts`.
 */
import "@fontsource-variable/inter-tight/wght.css";
import type { ThemePageProps } from "../types";
import About from "./components/About.astro";
import Career from "./components/Career.astro";
import Figures from "./components/Figures.astro";
import Footer from "./components/Footer.astro";
import Header from "./components/Header.astro";
import Hero from "./components/Hero.astro";
import Principles from "./components/Principles.astro";
import ProjectIndex from "./components/ProjectIndex.astro";
import Quote from "./components/Quote.astro";
import Record from "./components/Record.astro";

type Props = ThemePageProps;

const { portfolio } = Astro.props;
const { profile } = portfolio;
---

<a class="skip" href="#index">Skip to the index</a>
<Header profile={profile} />
<main>
  <Hero portfolio={portfolio} />
  <ProjectIndex portfolio={portfolio} />
  <Figures numbers={profile.numbers} />
  <About profile={profile} />
  <Principles principles={profile.principles} />
  <Quote quote={profile.quote} />
  <Career profile={profile} />
  <Record talks={profile.talks} />
</main>
<Footer profile={profile} />

<style is:global>
  /* Every theme's CSS ships on the one page: everything global is scoped to html[data-theme="minimal"]. */
  html[data-theme="minimal"] {
    --ink: #111111;
    --ink-2: #4a4a4a; /* 8.9:1 on white */
    --mute: #6b6b6b; /* 5.3:1, labels and small text */
    --mute-lg: #8a8a8a; /* 3.4:1, large text only (≥ 24px) */
    --rule: #e3e3e3;
    --paper: #ffffff;
    --gutter: clamp(16px, 3vw, 40px);
    --gap: 24px;
    --max: 1360px;
    --header-h: 57px;
    --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
    --ease-io: cubic-bezier(0.77, 0, 0.18, 1);
    --ease-slide: cubic-bezier(0.2, 0.7, 0.2, 1);

    --switcher-font: "Inter Tight Variable", "Inter Tight", system-ui, sans-serif;
    --switcher-fg: var(--ink);
    --switcher-muted: var(--mute);
    --switcher-bg: var(--paper);
    --switcher-border: 1px solid var(--rule);
    --switcher-radius: 0;
    --switcher-shadow: 0 10px 30px -18px rgb(0 0 0 / 0.35);
    --switcher-accent: var(--ink);

    background: var(--paper);
    color: var(--ink);
    font-family: "Inter Tight Variable", "Inter Tight", system-ui, sans-serif;
    font-feature-settings: "tnum" 1, "ss01" 1;
    font-variant-numeric: tabular-nums;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    text-rendering: optimizeLegibility;
    -webkit-text-size-adjust: 100%;
    text-size-adjust: 100%;
    scroll-padding-top: calc(var(--header-h) + 16px);
  }

  @media (max-width: 1099px) {
    html[data-theme="minimal"] {
      --gap: 16px;
    }
  }

  @media (max-width: 760px) {
    html[data-theme="minimal"] {
      --header-h: 52px;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    html[data-theme="minimal"] {
      scroll-behavior: smooth;
    }
  }

  [data-theme="minimal"] body {
    margin: 0;
    background: var(--paper);
    overflow-x: clip;
  }

  [data-theme="minimal"] *,
  [data-theme="minimal"] *::before,
  [data-theme="minimal"] *::after {
    box-sizing: border-box;
  }

  [data-theme="minimal"] a {
    color: inherit;
  }

  [data-theme="minimal"] ::selection {
    background: var(--ink);
    color: var(--paper);
  }

  [data-theme="minimal"] :focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }

  [data-theme="minimal"] .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  [data-theme="minimal"] .skip {
    position: fixed;
    top: 8px;
    left: 8px;
    z-index: 50;
    padding: 8px 12px;
    background: var(--ink);
    color: var(--paper);
    font-size: 14px;
    text-decoration: none;
    transform: translateY(-160%);
  }

  [data-theme="minimal"] .skip:focus-visible {
    transform: none;
  }

  /* Layout */

  :where([data-theme="minimal"]) .mn-wrap {
    width: 100%;
    max-width: calc(var(--max) + 2 * var(--gutter));
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  :where([data-theme="minimal"]) .mn-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gap);
  }

  @media (max-width: 760px) {
    :where([data-theme="minimal"]) .mn-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  :where([data-theme="minimal"]) .mn-label {
    margin: 0;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0;
  }

  /* Links: an underline that draws in from the left. */
  :where([data-theme="minimal"]) .mn-link {
    text-decoration: none;
    background: linear-gradient(currentColor, currentColor) no-repeat 100% 100% / 0 1px;
    transition: background-size 0.5s var(--ease-io);
  }

  :where([data-theme="minimal"]) .mn-link:hover,
  :where([data-theme="minimal"]) .mn-link:focus-visible {
    background-position: 0 100%;
    background-size: 100% 1px;
  }

  /* Hairline rules that draw in as they enter the viewport. `--mn-rule--bottom` puts the rule under the element. */
  :where([data-theme="minimal"]) .mn-rule {
    position: relative;
  }

  :where([data-theme="minimal"]) .mn-rule::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 1px;
    background: var(--rule-color, var(--rule));
    transform-origin: left;
    pointer-events: none;
  }

  :where([data-theme="minimal"]) .mn-rule--bottom::before {
    top: auto;
    bottom: 0;
  }

  /* Reveals: scroll-driven where supported, IntersectionObserver (`.mn-io`) elsewhere, nothing under reduced motion. */
  @keyframes mn-rise {
    from {
      opacity: 0;
      transform: translateY(var(--rise, 1.1rem));
    }
  }

  @keyframes mn-draw {
    from {
      transform: scaleX(0);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      :where([data-theme="minimal"]) .mn-reveal {
        animation: mn-rise both var(--ease-out);
        animation-timeline: view();
        animation-range: entry 0% cover var(--range-end, 22%);
      }

      :where([data-theme="minimal"]) .mn-rule {
        view-timeline: --mn-rule block;
      }

      :where([data-theme="minimal"]) .mn-rule::before {
        animation: mn-draw both var(--ease-io);
        animation-timeline: --mn-rule;
        animation-range: entry 0% cover 30%;
      }
    }

    /* Set by the disclosure FLIP on elements in motion. */
    :where([data-theme="minimal"]) .mn-hold .mn-reveal,
    :where([data-theme="minimal"]) .mn-hold.mn-reveal,
    :where([data-theme="minimal"]) .mn-hold .mn-rule::before,
    :where([data-theme="minimal"]) .mn-hold.mn-rule::before {
      animation: none;
    }

    :where([data-theme="minimal"].mn-io) .mn-reveal {
      transition:
        opacity 0.9s ease var(--d, 0ms),
        transform 1.1s var(--ease-out) var(--d, 0ms);
    }

    :where([data-theme="minimal"].mn-io) .mn-reveal:not(.is-in) {
      opacity: 0;
      transform: translateY(var(--rise, 1.1rem));
    }

    :where([data-theme="minimal"].mn-io) .mn-rule::before {
      transition: transform 1.2s var(--ease-io) var(--d, 0ms);
    }

    :where([data-theme="minimal"].mn-io) .mn-rule:not(.is-in)::before {
      transform: scaleX(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :where([data-theme="minimal"]) .mn-link {
      transition: none;
    }
  }
</style>
