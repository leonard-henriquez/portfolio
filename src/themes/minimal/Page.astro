---
/**
 * Minimal: Swiss minimal. One 12-column grid, Inter Tight with tabular figures.
 * Scannable by default, details on demand: every list is the same table (components/Disclosure.astro),
 * one line per item, with the rest in a panel that opens on click (and is open without JS).
 * Document-level settings (theme colour, font preload, the pre-paint `boot`) live in `meta.ts`;
 * behaviour lives in `client.ts`.
 *
 * Type scale: four styles, one per field kind, the same in every section (tokens below).
 * - Display (--t-display, 500): the hero headline, the contact line.
 * - Title   (--t-title, 500, ink): item names in every table (project, organization, school, principle, talk), figures.
 * - Body    (--t-body, 400): descriptors and prose. Ink for leads (about, a project's dek, an organization's summary,
 *           role titles in a panel), ink-2 for everything else (focus, role, program, descriptions, highlights).
 * - Small   (--t-small, 400): labels and metadata. Ink for section labels, navigation and controls; mute for
 *           numbers, statuses, types, periods, captions, fact labels and lists of skills.
 * Importance shows through order and amount of content, never through per-item styling.
 */
import "@fontsource-variable/inter-tight/wght.css";
import type { ThemePageProps } from "../types";
import "./global.css";
import About from "./components/About.astro";
import Footer from "./components/Footer.astro";
import Header from "./components/Header.astro";
import Hero from "./components/Hero.astro";
import Principles from "./components/Principles.astro";
import ProjectIndex from "./components/ProjectIndex.astro";
import Record from "./components/Record.astro";

type Props = ThemePageProps;

const { portfolio } = Astro.props;
const { profile } = portfolio;
---

<a class="skip" href="#projects">Skip to the projects</a>
<Header profile={profile} />
<main>
  <Hero portfolio={portfolio} />
  <ProjectIndex portfolio={portfolio} />
  <About profile={profile} />
  <Principles principles={profile.principles} />
  <Record talks={profile.talks} />
</main>
<Footer profile={profile} />
