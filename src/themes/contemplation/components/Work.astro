---
/**
 * Selected work: released and in-progress projects. A row shows the project's landscape, role, name and summary,
 * status and period; it opens on the long description, the results, the facts and links, a link to the project's own page
 * (ProjectPage.astro), and the highlights when there are some.
 */
import { Image } from "astro:assets";
import type { Project } from "../../../lib/portfolio";
import { vistaOf } from "../vista";
import Disclosure from "./Disclosure.astro";

interface Props {
  projects: Project[];
  span: string;
}

const { projects, span } = Astro.props;
---

{
  projects.length > 0 && (
    <section id="work" class="ct-section ct-wrap" aria-labelledby="work-title">
      <div class="ct-head">
        <h2 id="work-title" class="ct-mono">Selected work</h2>
        <span class="ct-mono ct-aside">{span}</span>
      </div>
      <ul class="ct-list" role="list" data-ct-disclosures>
        {projects.map((p) => {
          const vista = vistaOf(p);
          const img = vista ?? p.image.illustration;
          const facts = [...p.stack, ...p.tags];
          return (
            <Disclosure id={p.anchor} rowClass="work-row" panelClass="work-row">
              <Fragment slot="row">
                <span class="thumb" style={vista ? `--sky: ${vista.sky}` : undefined}>
                  <Image
                    src={img.src}
                    alt=""
                    widths={[200, 400]}
                    sizes="200px"
                    loading="lazy"
                    decoding="async"
                    style={vista ? `object-position: ${vista.x} 66%` : undefined}
                  />
                </span>
                <span class="main">
                  <span class="ct-mono ct-aside">{p.role}</span>
                  <span class="name ct-title">{p.title}</span>
                  <span class="ct-body">
                    <span class="sr-only">, </span>
                    {p.summary}
                  </span>
                </span>
                <span class="when ct-mono">
                  <span class="sr-only">, </span>
                  {p.statusLabel} · {p.period}
                </span>
              </Fragment>

              <div class="more">
                {p.hasBody && <div class="prose ct-body" set:html={p.html} />}
                {p.results.length > 0 && <p class="results ct-mono">{p.results.join(" · ")}</p>}
                {(facts.length > 0 || p.links.length > 0) && (
                  <p class="facts ct-mono">
                    {facts.join(" · ")}
                    {p.links.map((link, i) => (
                      <>
                        {(facts.length > 0 || i > 0) && " · "}
                        <a href={link.href} rel="noopener">
                          {link.label}
                          <span aria-hidden="true"> ↗</span>
                        </a>
                      </>
                    ))}
                  </p>
                )}
                <a class="ct-page ct-mono" href={p.href}>
                  The project's page<span aria-hidden="true"> →</span>
                </a>
              </div>

              {p.highlights.length > 0 && (
                <ul class="highlights" role="list" aria-label={`${p.title} highlights`}>
                  {p.highlights.map((h) => (
                    <li>
                      <h4 class="hl-title">{h.title}</h4>
                      <p class="ct-body">{h.body}</p>
                      {h.result && <p class="hl-result ct-mono">{h.result}</p>}
                      {h.stack.length > 0 && <p class="hl-stack ct-mono">{h.stack.join(" · ")}</p>}
                    </li>
                  ))}
                </ul>
              )}
            </Disclosure>
          );
        })}
      </ul>
    </section>
  )
}

<style>
  /* Landscape · role, name, summary · status and period · + (the panel keeps the columns). */
  :global(.work-row) {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr) auto 16px;
    column-gap: 40px;
    align-items: center;
  }

  .thumb {
    grid-column: 1;
    grid-row: 1;
    display: block;
    height: 124px;
    overflow: hidden;
    border-radius: 3px;
    background: var(--sky, var(--rule));
  }

  .thumb :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s var(--ease);
  }

  :global(.work-row:hover) .thumb :global(img) {
    transform: scale(1.07);
  }

  .main {
    grid-column: 2;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-width: 64ch;
  }

  .name {
    font-size: clamp(24px, 2.2vw, 32px);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .when {
    grid-column: 3;
    grid-row: 1;
    color: var(--accent);
    text-align: right;
    white-space: nowrap;
  }

  /* The panel, under the summary. */
  .more,
  .highlights {
    grid-column: 2 / span 2;
  }

  .more {
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: 64ch;
  }

  .prose :global(p) {
    margin: 0;
  }

  .prose :global(p + p) {
    margin-top: 0.6em;
  }

  .results,
  .facts {
    margin: 0;
    font-size: 11px;
    line-height: 1.6;
  }

  .highlights {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 28px 40px;
    margin: 32px 0 0;
    padding: 0;
    list-style: none;
  }

  .highlights > li {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding-top: 14px;
    border-top: 1px solid var(--rule);
  }

  .highlights p {
    margin: 0;
  }

  .hl-title {
    margin: 0;
    font-size: 18px;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  .hl-result,
  .hl-stack {
    font-size: 11px;
    line-height: 1.6;
  }

  .hl-stack {
    color: var(--accent);
  }

  @media (max-width: 860px) {
    :global(.work-row) {
      grid-template-columns: minmax(0, 1fr) 16px;
      column-gap: 16px;
      row-gap: 14px;
    }

    .thumb {
      height: 160px;
    }

    .thumb,
    .main,
    .when,
    .more,
    .highlights {
      grid-column: 1;
      grid-row: auto;
      text-align: left;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .thumb :global(img) {
      transition: none;
    }
  }
</style>
