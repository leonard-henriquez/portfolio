---
/** Explorations: research and studies, one row each: name, summary and the long description, status. */
import type { Project } from "../../../lib/portfolio";

interface Props {
  projects: Project[];
}

const { projects } = Astro.props;
---

{
  projects.length > 0 && (
    <section id="explorations" class="ct-section ct-wrap" aria-labelledby="explorations-title">
      <div class="ct-head">
        <h2 id="explorations-title" class="ct-mono">Explorations</h2>
        <span class="ct-mono ct-aside">{[...new Set(projects.map((p) => p.role))].join(" · ")}</span>
      </div>
      <ul class="ct-list" role="list">
        {projects.map((p) => (
          <li id={p.anchor} class="row ct-reveal">
            <h3 class="ct-title name">{p.title}</h3>
            <div class="text">
              <p class="ct-body">{p.summary}</p>
              {p.hasBody && <div class="prose ct-body" set:html={p.html} />}
            </div>
            <span class="when ct-mono ct-aside">
              {p.statusLabel} — {p.period}
            </span>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 40px;
    padding: 22px 0;
  }

  .name {
    flex: 0 0 300px;
  }

  .text {
    flex: 1 1 360px;
    min-width: 0;
    max-width: 68ch;
  }

  .prose :global(p) {
    margin: 0.6em 0 0;
  }

  .when {
    flex: 0 0 150px;
    text-align: right;
  }

  @media (max-width: 760px) {
    .name,
    .when {
      flex-basis: 100%;
      text-align: left;
    }
  }
</style>
