---
/**
 * Explorations: research and studies, after a line on what they are. A row shows the name, the summary and the status;
 * it opens on the excerpt, the figures and facts (as in Selected work) and a link to the project's own page.
 */
import type { Project } from "../../../lib/portfolio";
import Disclosure from "./Disclosure.astro";
import ProjectFacts from "./ProjectFacts.astro";

interface Props {
  projects: Project[];
  intro?: string;
}

const { projects, intro } = Astro.props;
---

{
  projects.length > 0 && (
    <section id="explorations" class="ct-section ct-wrap" aria-labelledby="explorations-title">
      <div class="ct-head">
        <h2 id="explorations-title" class="ct-mono">Explorations</h2>
        <span class="ct-mono ct-aside">{[...new Set(projects.map((p) => p.role))].join(" · ")}</span>
      </div>
      {intro && <p class="intro ct-body">{intro}</p>}
      <ul class="ct-list" role="list" data-ct-disclosures>
        {projects.map((p) => (
          <Disclosure id={p.anchor} rowClass="ct-cols" panelClass="ct-cols">
            <Fragment slot="row">
              <span class="ct-name ct-title">{p.shortTitle}</span>
              <span class="ct-desc ct-body">
                <span class="sr-only">, </span>
                {p.focus}
              </span>
              <span class="ct-when ct-mono">
                <span class="sr-only">, </span>
                {p.statusLabel} · {p.period}
              </span>
            </Fragment>

            <div class="ct-under ct-body">
              {p.title !== p.shortTitle && <p class="ct-mono ct-aside">{p.title}</p>}
              <p>{p.summary}</p>
              {p.excerpt && <p>{p.excerpt}</p>}
              <ProjectFacts project={p} />
              <p>
                <a class="ct-page ct-mono" href={p.href}>
                  The project's page<span aria-hidden="true"> →</span>
                </a>
              </p>
            </div>
          </Disclosure>
        ))}
      </ul>
    </section>
  )
}

<style>
  .intro {
    max-width: 60ch;
    margin: 20px 0 0;
  }

  .ct-under {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .ct-under :global(p) {
    margin: 0;
  }
</style>
