---
/** What production agents taught me, as a grid, then talks, juries and recognition on one line. */
import type { Profile } from "../../../lib/portfolio";

interface Props {
  profile: Profile;
}

const { principles, talks, sections } = Astro.props.profile;
---

{
  principles.length > 0 && (
    <section id="principles" class="ct-section ct-wrap" aria-labelledby="principles-title">
      <div class="ct-head">
        <h2 id="principles-title" class="ct-mono">
          {sections.principles.summary?.replace(/\.$/, "") ?? "Principles"}
        </h2>
      </div>
      {sections.principles.intro && <p class="intro ct-body">{sections.principles.intro}</p>}
      <ol class="grid" role="list">
        {principles.map((r) => (
          <li class="ct-reveal">
            <span class="ct-mono ct-aside">{r.no2}</span>
            <h3 class="name">{r.title}</h3>
            <p class="ct-body">{r.body}</p>
          </li>
        ))}
      </ol>
    </section>
  )
}

{
  talks.length > 0 && (
    <section id="talks" class="talks ct-wrap" aria-labelledby="talks-title">
      <h2 id="talks-title" class="ct-mono ct-aside">
        Talks &amp; juries
      </h2>
      <ul role="list">
        {talks.map((t) => (
          <li>
            {t.text}
            {t.year && (
              <>
                , <time datetime={String(t.year)}>{t.year}</time>
              </>
            )}
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .intro {
    max-width: 60ch;
    margin: 20px 0 0;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 32px 48px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }

  .grid > li {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .name {
    margin: 0;
    font-size: 24px;
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .talks {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px 28px;
    margin-top: clamp(56px, 6vw, 88px);
  }

  .talks > * {
    margin: 0;
  }

  .talks h2 {
    width: 100%;
    padding-top: 16px;
    border-top: 1px solid var(--rule);
  }

  .talks ul {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 28px;
    padding: 0;
    list-style: none;
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink-2);
  }
</style>
