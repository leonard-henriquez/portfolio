---
/**
 * What production agents taught me: the section intro on the left, one row per lesson on the right
 * (number, title), opening on its body.
 * Then talks, juries and recognition, as plain rows: the text, then the year.
 */
import type { Profile } from "../../../lib/portfolio";
import Disclosure from "./Disclosure.astro";

interface Props {
  profile: Profile;
}

const { principles, talks, sections } = Astro.props.profile;
---

{
  principles.length > 0 && (
    <section id="principles" class="ct-section ct-wrap" aria-labelledby="principles-title">
      <div class="ct-head">
        <h2 id="principles-title" class="ct-mono">
          {sections.principles.summary?.replace(/\.$/, "") ?? "Principles"}
        </h2>
      </div>
      <div class:list={["split", { solo: !sections.principles.intro }]}>
        {sections.principles.intro && <p class="intro ct-body">{sections.principles.intro}</p>}
        <ol class="ct-list lessons" role="list" data-ct-disclosures>
          {principles.map((r) => (
            <Disclosure id={`principle-${r.no2}`} rowClass="lesson" panelClass="lesson">
              <Fragment slot="row">
                <span class="no ct-mono">
                  <span class="sr-only">No. </span>
                  {r.no2}
                </span>
                <span class="ct-title title">
                  <span class="sr-only">, </span>
                  {r.title}
                </span>
              </Fragment>
              <p class="body ct-body">{r.body}</p>
            </Disclosure>
          ))}
        </ol>
      </div>
    </section>
  )
}

{
  talks.length > 0 && (
    <section id="talks" class="ct-section ct-wrap" aria-labelledby="talks-title">
      <div class="ct-head">
        <h2 id="talks-title" class="ct-mono">
          Talks &amp; juries
        </h2>
      </div>
      <ul class="ct-list" role="list">
        {talks.map((t) => (
          <li class="talk ct-cols ct-reveal">
            <p class="ct-desc ct-body">{t.text}</p>
            {t.year && (
              <span class="ct-when ct-mono">
                <span class="sr-only">, </span>
                <time datetime={String(t.year)}>{t.year}</time>
              </span>
            )}
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  /* The intro beside the lessons: it reads first, then stays in view while they open. */
  .split {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
    gap: 24px 64px;
    align-items: start;
    padding-top: 20px;
  }

  /* Without an intro, the lessons take the whole width. */
  .solo {
    grid-template-columns: minmax(0, 1fr);
  }

  .intro {
    position: sticky;
    top: 24px;
    max-width: 38ch;
    font-size: 18px;
    line-height: 1.55;
  }

  .lessons {
    margin-top: -20px;
  }

  /* Number · title · + ; the body opens under the title. */
  :global(.lesson) {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) 16px;
    column-gap: 12px;
    align-items: baseline;
  }

  .no {
    grid-column: 1;
    grid-row: 1;
    color: var(--accent);
  }

  .title {
    grid-column: 2;
    grid-row: 1;
    font-size: clamp(22px, 1.9vw, 26px);
    letter-spacing: -0.025em;
  }

  .body {
    grid-column: 2;
    max-width: 60ch;
  }

  .talk {
    padding: 16px 0;
  }

  /* Nothing in the name column: the text starts at the left edge. */
  .talk .ct-desc {
    grid-column: 1 / span 2;
  }

  @media (max-width: 860px) {
    .split {
      grid-template-columns: minmax(0, 1fr);
    }

    .intro {
      position: static;
    }

    .lessons {
      margin-top: 0;
    }
  }
</style>
