---
/**
 * One list row that opens a panel: the theme's one disclosure, for every list that has more to say.
 * The `row` slot holds the row's cells (phrasing content only: it sits in a <button>), laid out by the caller's
 * `rowClass`; the default slot holds the panel's content, laid out by `panelClass`.
 * Without JS the panel is shown (see global.css); with it, client.ts toggles and animates it, and opens it when the
 * URL fragment names `id`. `hidden="until-found"` lets find-in-page open it too.
 */
interface Props {
  /** Element id of the item, also its deep link. */
  id: string;
  rowClass?: string;
  panelClass?: string;
  /** Heading level of the row, so each section keeps its outline. */
  level?: 3 | 4;
}

const { id, rowClass, panelClass, level = 3 } = Astro.props;
const Heading = `h${level}` as "h3" | "h4";
---

<li class="ct-item" id={id} data-ct-item>
  <Heading class="ct-item-h">
    <button
      type="button"
      class:list={["ct-row", "ct-reveal", rowClass]}
      id={`${id}-button`}
      aria-controls={`${id}-panel`}
      data-ct-row
    >
      <slot name="row" />
      <span class="ct-plus" aria-hidden="true"></span>
    </button>
  </Heading>
  <div class="ct-panel" id={`${id}-panel`} role="region" aria-labelledby={`${id}-button`} hidden="until-found" data-ct-panel>
    <div class:list={["ct-panel-in", panelClass]}>
      <slot />
    </div>
  </div>
</li>
