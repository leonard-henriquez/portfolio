---
/** About: the short version large, the long one beside it. A landscape rises under it. */
import { Image } from "astro:assets";
import type { Profile } from "../../../lib/portfolio";
import { ABOUT_VISTA } from "../vista";

interface Props {
  profile: Profile;
}

const { about } = Astro.props.profile;
---

<section id="about" class="about" aria-labelledby="about-title" style={`--sky: ${ABOUT_VISTA.sky}`}>
  <div class="text ct-wrap ct-reveal">
    <div class="main">
      <h2 id="about-title" class="ct-mono">About</h2>
      <p class="short">{about.short}</p>
    </div>
    <div class="side">
      {about.long.map((p) => <p>{p}</p>)}
    </div>
  </div>
  <Image
    src={ABOUT_VISTA.src}
    alt={ABOUT_VISTA.alt}
    widths={[960, 1280, ABOUT_VISTA.src.width]}
    sizes="100vw"
    class="art"
    loading="lazy"
    decoding="async"
  />
</section>

<style>
  .about {
    position: relative;
    margin-top: var(--section);
    overflow: hidden;
    background: var(--sky);
    color: var(--ink-deep);
  }

  .text {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 24px 64px;
    padding-top: clamp(64px, 8vw, 120px);
  }

  .main {
    flex: 1 1 520px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .main h2 {
    margin: 0;
  }

  .short {
    margin: 0;
    font-size: clamp(26px, 2.8vw, 40px);
    font-weight: 500;
    line-height: 1.18;
    letter-spacing: -0.03em;
    text-wrap: pretty;
  }

  .side {
    flex: 1 1 320px;
    align-self: end;
    display: flex;
    flex-direction: column;
    gap: 0.8em;
    font-size: 18px;
    line-height: 1.55;
  }

  .side > p {
    margin: 0;
    text-wrap: pretty;
  }

  .art {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    margin-top: calc(-1 * clamp(64px, 20vw, 340px));
  }
</style>
