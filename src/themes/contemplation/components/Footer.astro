---
/** Contact: the invitation, the preferred channel as a large link, the other links; a landscape closes the page. */
import { Image } from "astro:assets";
import { MARKDOWN_PATHS } from "../../../lib/markdown";
import type { Profile } from "../../../lib/portfolio";
import { CONTACT_VISTA } from "../vista";

interface Props {
  profile: Profile;
}

const { profile } = Astro.props;
const { intro, preferred, links } = profile.contact;
const year = new Date().getFullYear();
// For AI agents: the Markdown version of the site (src/lib/markdown.ts).
const llmsTxt = new URL(MARKDOWN_PATHS.index, Astro.site);
---

<footer id="contact" class="footer" aria-labelledby="contact-title" style={`--sky: ${CONTACT_VISTA.sky}`}>
  <div class="inner ct-wrap">
    <h2 id="contact-title" class="ct-mono">Contact</h2>
    {intro && <p class="pitch">{intro}</p>}
    <a class="cta" href={preferred.href} rel="me noopener">
      Message me on {preferred.label}<span aria-hidden="true"> ↗</span>
    </a>
    <div class="base" data-switcher-avoid>
      <ul class="links" role="list">
        {
          links.map((link) => (
            <li>
              <a class="ct-mono" href={link.href} rel="me noopener">
                {link.label}
              </a>
            </li>
          ))
        }
        <li>
          <a class="ct-mono" href={llmsTxt} type="text/plain" title="This site as Markdown, for AI agents">llms.txt</a>
        </li>
      </ul>
      <p class="ct-mono">{profile.location.label}</p>
      <p class="ct-mono">© {year} {profile.name}</p>
      <a class="ct-mono" href="#top">Back to top <span aria-hidden="true">↑</span></a>
    </div>
  </div>
  <Image
    src={CONTACT_VISTA.src}
    alt={CONTACT_VISTA.alt}
    widths={[960, 1280, CONTACT_VISTA.src.width]}
    sizes="100vw"
    class="art"
    loading="lazy"
    decoding="async"
  />
</footer>

<style>
  .footer {
    position: relative;
    margin-top: var(--section);
    overflow: hidden;
    background: var(--sky);
    color: var(--ink-deep);
  }

  .footer a {
    color: var(--ink-deep);
  }

  .inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding-top: clamp(80px, 10vw, 136px);
  }

  .inner > h2,
  .inner > p {
    margin: 0;
  }

  .pitch {
    max-width: 34ch;
    font-size: clamp(20px, 1.8vw, 26px);
    line-height: 1.3;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .cta {
    font-size: clamp(30px, 3.6vw, 54px);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.04em;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .cta:hover {
    text-decoration: underline;
    text-decoration-thickness: max(2px, 0.04em);
    text-underline-offset: 0.1em;
  }

  .base {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px 28px;
    padding-top: 16px;
    border-top: 1px solid var(--ink-deep);
  }

  .base > p {
    margin: 0;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .art {
    position: relative;
    display: block;
    width: 100%;
    height: auto;
    margin-top: calc(-1 * clamp(40px, 16vw, 280px));
  }
</style>
