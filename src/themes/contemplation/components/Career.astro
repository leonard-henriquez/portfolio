---
/**
 * Experience: one row per organization (name, latest title with "+n" for earlier ones, years), opening on its
 * summary and every role (title, type, dates, text, highlights, skills). Education: plain rows on the same columns.
 */
import type { Profile } from "../../../lib/portfolio";
import Disclosure from "./Disclosure.astro";

interface Props {
  profile: Profile;
}

const { experience, education } = Astro.props.profile;
---

{
  experience.length > 0 && (
    <section id="experience" class="ct-section ct-wrap" aria-labelledby="experience-title">
      <div class="ct-head">
        <h2 id="experience-title" class="ct-mono">Experience</h2>
      </div>
      <ul class="ct-list" role="list" data-ct-disclosures>
        {experience.map((org) => {
          const [latest] = org.roles;
          const earlier = org.roles.length - 1;
          return (
            <Disclosure id={org.anchor} rowClass="ct-cols" panelClass="ct-cols">
              <Fragment slot="row">
                <span class="ct-name ct-title">{org.org}</span>
                <span class="ct-desc ct-body">
                  <span class="sr-only">, </span>
                  {latest.title}
                  {earlier > 0 && (
                    <span class="more ct-mono">
                      <span aria-hidden="true"> +{earlier}</span>
                      <span class="sr-only">
                        , and {earlier} earlier {earlier === 1 ? "role" : "roles"}
                      </span>
                    </span>
                  )}
                </span>
                <span class="ct-when ct-mono">
                  <span class="sr-only">, </span>
                  {org.years}
                </span>
              </Fragment>

              <div class="ct-under panel">
                {org.details.length > 0 && <p class="ct-mono ct-aside">{org.details.join(" · ")}</p>}
                {org.summary && <p class="ct-body">{org.summary}</p>}
                <ul class="roles" role="list">
                  {org.roles.map((role) => (
                    <li>
                      <h4 class="role-title">{role.title}</h4>
                      <p class="ct-mono ct-aside">
                        {role.typeLabel} · <time datetime={role.start.iso}>{role.start.label}</time> –{" "}
                        {role.end ? <time datetime={role.end.iso}>{role.end.label}</time> : "present"}
                        {!role.current && ` · ${role.duration}`}
                      </p>
                      {role.text && <p class="ct-body">{role.text}</p>}
                      {role.highlights.map((h) => (
                        <p class="ct-body">{h}</p>
                      ))}
                      {role.skills.length > 0 && <p class="skills ct-mono">{role.skills.join(" · ")}</p>}
                    </li>
                  ))}
                </ul>
                {(org.href || org.project) && (
                  <p class="links ct-mono">
                    {org.href && (
                      <a href={org.href} rel="noopener">
                        {new URL(org.href).hostname.replace(/^www\./, "")}
                        <span aria-hidden="true"> ↗</span>
                      </a>
                    )}
                    {org.project && (
                      <a href={`#${org.project.anchor}`}>
                        {org.project.title} in selected work <span aria-hidden="true">↑</span>
                      </a>
                    )}
                  </p>
                )}
              </div>
            </Disclosure>
          );
        })}
      </ul>
    </section>
  )
}

{
  education.length > 0 && (
    <section id="education" class="ct-section ct-wrap" aria-labelledby="education-title">
      <div class="ct-head">
        <h2 id="education-title" class="ct-mono">Education</h2>
      </div>
      <ul class="ct-list" role="list">
        {education.map((e) => (
          <li id={e.anchor} class="school ct-cols ct-reveal">
            <h3 class="ct-name ct-title">
              {e.href ? (
                <a href={e.href} rel="noopener">
                  {e.school}
                </a>
              ) : (
                e.school
              )}
            </h3>
            <p class="ct-desc ct-body">
              <span class="sr-only">, </span>
              {e.program}
            </p>
            <span class="ct-when ct-mono">
              <span class="sr-only">, </span>
              {e.years}
            </span>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .more {
    color: var(--accent);
  }

  .panel {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .panel p {
    margin: 0;
  }

  .roles {
    display: flex;
    flex-direction: column;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .roles > li {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .role-title {
    margin: 0;
    font-size: 17px;
    font-weight: 500;
    line-height: 1.35;
  }

  .skills {
    font-size: 11px;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
  }

  .school {
    padding: 22px 0;
  }
</style>
